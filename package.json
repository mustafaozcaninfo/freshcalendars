{
  "name": "freshcalendars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "fc": "tsx packages/generator/src/cli.ts",
    "build": "tsx packages/generator/src/cli.ts build",
    "test": "tsx --test packages/generator/src/newsRules.test.ts packages/engine/src/resolve.test.ts packages/engine/src/content/editorial.test.ts packages/engine/src/content/holidayEditorial.test.ts packages/engine/src/holidays/holidays.test.ts apps/news/test/*.test.ts",
    "verify": "tsx packages/generator/src/cli.ts verify",
    "gen": "tsx packages/generator/src/cli.ts gen",
    "refresh-evergreen": "tsx packages/generator/src/cli.ts refresh-evergreen",
    "deploy": "tsx packages/generator/src/cli.ts deploy",
    "smoke": "bash scripts/smoke.sh",
    "smoke:auto": "tsx scripts/smoke-automation.mjs",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "smoke:contrast": "node scripts/smoke-contrast.mjs",
    "smoke:ads": "node scripts/smoke-ads.mjs",
    "smoke:lighthouse": "node scripts/smoke-lighthouse.mjs",
    "news:dev": "pnpm --filter @freshcalendars/news dev",
    "news:build": "pnpm --filter @freshcalendars/news build",
    "news:schema-test": "bash apps/news/test/schema-negative.sh",
    "news:links": "node apps/news/test/links.mjs",
    "news:lighthouse": "node scripts/news-lighthouse.mjs",
    "news:serve": "node scripts/news-serve.mjs",
    "news:verify": "node scripts/news-verify.mjs",
    "news:deploy": "bash scripts/news-deploy.sh",
    "news:seo-audit": "node scripts/news-seo-audit.mjs",
    "news:abbrev": "node scripts/news-abbrev-check.mjs",
    "news:puzzle-check": "node scripts/news-puzzle-check.mjs",
    "news:puzzle-data": "node scripts/news-puzzle-data.mjs",
    "news:index": "node scripts/index-submit.mjs",
    "news:dashboard": "tsx scripts/news-dashboard.mjs",
    "news:verify-live": "node scripts/news-verify-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "version": "1.0.0"
}
