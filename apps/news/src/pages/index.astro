---
import HomeView from "../components/HomeView.astro";
import { getActiveCategories, getCategoryNames, getPublishedArticles } from "../lib/articles";
import { getCollection } from "astro:content";
import { HOME, homePages } from "../lib/pages";

const [page] = await homePages();
const all = await getPublishedArticles();
// Bylines on the hub keep every author page linked, even before a first story.
const authors = (await getCollection("authors")).map((a) => ({ id: a.id, name: a.data.name }));
---
<HomeView
  page={page!}
  all={all}
  heading={HOME.heading}
  intro={HOME.intro}
  description={HOME.description}
  categories={await getActiveCategories(all)}
  categoryNames={await getCategoryNames()}
  authors={authors}
/>
