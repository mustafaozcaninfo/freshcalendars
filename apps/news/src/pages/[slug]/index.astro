---
import { getEntry, render } from "astro:content";
import NewsBase from "../../layouts/NewsBase.astro";
import AdSlot from "../../components/AdSlot.astro";
import ArticleMeta from "../../components/ArticleMeta.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CalendarLinks from "../../components/CalendarLinks.astro";
import DownloadGrid from "../../components/DownloadGrid.astro";
import Corrections from "../../components/Corrections.astro";
import Faq from "../../components/Faq.astro";
import Hero from "../../components/Hero.astro";
import KeyPoints from "../../components/KeyPoints.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import Sources from "../../components/Sources.astro";
import Toc from "../../components/Toc.astro";
import SectionBar from "../../components/SectionBar.astro";
import ArticleAside from "../../components/ArticleAside.astro";
import ShareBar from "../../components/ShareBar.astro";
import PreferredSource from "../../components/PreferredSource.astro";
import ShareIcons from "../../components/ShareIcons.astro";
import NewsBar from "../../components/NewsBar.astro";
import StoryNav from "../../components/StoryNav.astro";
import { authorHref, getPublishedArticles, lastModified, type Article } from "../../lib/articles";
import { authorImage, heroImages } from "../../lib/images";
import { SITE_ORIGIN, absNewsUrl } from "../../lib/site";
import { relatedFor, topicsOf } from "../../lib/storygraph";
import { topicPath } from "../../lib/topics";
import { upcomingFor } from "../../lib/keydates";
import KeyDates from "../../components/KeyDates.astro";
import {
  articleGraph,
  articleHeadTags,
  articlePath,
  categoryPath,
  countWords,
  pageTitle,
  readingMinutes,
  type ArticleSeo,
  type AuthorSeo,
} from "../../lib/seo";

export async function getStaticPaths() {
  const all = await getPublishedArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const d = article.data;
const { Content, headings, remarkPluginFrontmatter } = await render(article);
// Stories with room for two in-article units carry Fresh_News_5 in the body (rehypeMidArticleAd), not at the end.
const endAd = (remarkPluginFrontmatter?.adsInBody ?? 0) < 2;

const category = (await getEntry(d.category))!;
const authors = await Promise.all(d.authors.map(async (ref) => (await getEntry(ref))!));
const authorPath = authorHref;

const hero = await heroImages(d.hero.src);
// Pinterest gets the first printable (a tall page, the format Pinterest favors), else the hero.
const shareImage = d.downloads[0] ? absNewsUrl(d.downloads[0].png) : hero.main.url;

const wordCount = countWords(article.body ?? "");
const minutes = readingMinutes(wordCount);
const modifiedAt = lastModified(article);

const authorSeo: AuthorSeo[] = await Promise.all(
  authors.map(async (a) => ({
    kind: a.data.kind,
    name: a.data.name,
    path: authorPath(a.id),
    role: a.data.role,
    sameAs: a.data.sameAs,
    image: a.data.photo ? await authorImage(a.data.photo) : undefined,
  })),
);

const seo: ArticleSeo = {
  slug: article.id,
  title: d.title,
  seoTitle: d.seoTitle,
  description: d.description,
  type: d.type,
  publishedAt: d.publishedAt,
  modifiedAt,
  authors: authorSeo,
  category: { slug: category.id, name: category.data.name },
  keywords: d.keywords,
  hero: {
    main: hero.main,
    crops: hero.crops,
    alt: d.hero.alt,
    title: d.hero.title ?? d.title,
    caption: d.hero.caption,
    credit: d.hero.credit,
    license: d.hero.license,
  },
  wordCount,
  readingMinutes: minutes,
  downloads: d.downloads.map((x) => ({ name: x.title, description: x.description, pdf: `${SITE_ORIGIN}${x.pdf}`, png: `${SITE_ORIGIN}${x.png}` })),
};

// Related: the writer's picks first, then the most similar stories (lib/similarity.ts, lib/storygraph.ts).
const byId = new Map(all.map((a) => [a.id, a]));
const related = relatedFor(all, article.id, d.related.map((r) => r.id)).map((id) => byId.get(id)!).map((a) => ({
  href: articlePath(a.id),
  title: a.data.title,
  image: a.data.hero.src,
  alt: a.data.hero.alt,
  publishedAt: a.data.publishedAt,
}));

// End-of-story navigation: same-section stories not already in Related, and the stories
// published just before and after this one.
const linkOf = (a: Article) => ({ href: articlePath(a.id), title: a.data.title, publishedAt: a.data.publishedAt });
const relatedHrefs = new Set(related.map((r) => r.href));
const more = all.filter((a) => a.id !== article.id && a.data.category.id === category.id && !relatedHrefs.has(articlePath(a.id))).slice(0, 5).map(linkOf);
const pos = all.findIndex((a) => a.id === article.id);
const newer = pos > 0 ? linkOf(all[pos - 1]!) : undefined;
const older = pos >= 0 && pos < all.length - 1 ? linkOf(all[pos + 1]!) : undefined;
// Running topics this story belongs to (hub links) and its own upcoming dates (add to calendar).
const topics = d.noindex ? [] : topicsOf(all, article.id);
const keyDates = upcomingFor(new Set([article.id]));
---
<NewsBase
  title={pageTitle(d)}
  description={d.description}
  path={articlePath(article.id)}
  ogType="article"
  robots={d.noindex ? "noindex, follow" : undefined}
  headTags={articleHeadTags(seo)}
  jsonLd={articleGraph(seo)}
  section={category.id}
>
  <div class="progress" aria-hidden="true"><span></span></div>
  <SectionBar headings={headings} />
  <NewsBar section={category.id} />
  <AdSlot unit={7} variant="banner" />
  <div class="article-layout">
  <article class="news-wrap article">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "News", href: "/news/" },
      { name: category.data.name, href: categoryPath(category.id) },
      { name: d.title },
    ]} />
    <p class="kicker" data-cat={category.id}><a href={categoryPath(category.id)}>{category.data.name}</a></p>
    <h1 class={d.title.length > 80 ? "long" : undefined}>{d.title}</h1>
    <p class="news-lede">{d.description}</p>
    <div class="article-byline-row"><ArticleMeta
      authors={authors.map((a) => ({ name: a.data.name, href: authorPath(a.id), photo: a.data.photo }))}
      publishedAt={d.publishedAt}
      modifiedAt={modifiedAt}
      readingMinutes={minutes}
    />
    <ShareBar url={absNewsUrl(articlePath(article.id))} title={d.title} image={shareImage} compact />
    </div>
    <Hero src={d.hero.src} alt={d.hero.alt} title={d.hero.title ?? d.title} caption={d.hero.caption} credit={d.hero.credit} license={d.hero.license} />
    <AdSlot unit={6} variant="top" />
    <KeyPoints points={d.summary} />
    <KeyDates dates={keyDates} heading={keyDates.length === 1 ? "Key date" : "Key dates"} ics={`${articlePath(article.id)}dates.ics`} />
    {d.downloads.length > 0 && <p class="jump"><a href="#downloads">{d.downloads.length} free printable{d.downloads.length === 1 ? "" : "s"} below ↓</a></p>}
    <Toc headings={headings} />
    <div class="prose-news">
      <Content />
    </div>
    <DownloadGrid items={d.downloads} pageUrl={absNewsUrl(articlePath(article.id))} />
    <div class="after">
      <ShareBar url={absNewsUrl(articlePath(article.id))} title={d.title} image={shareImage} />
      <a class="top-link" href="#main">Back to top ↑</a>
    </div>
    <PreferredSource />
    <AdSlot unit={2} />
    <CalendarLinks links={d.internalLinks} />
    <Faq items={d.faq} />
    <Sources items={d.sources} />
    <Corrections items={d.corrections} />
    <AdSlot unit={4} />
    {authors.map((a) => (
      <AuthorCard name={a.data.name} role={a.data.role} bio={a.data.bio} href={authorPath(a.id)} photo={a.data.photo} />
    ))}
    {topics.length > 0 && (
      <nav class="topic-links" aria-label="Topics">
        <span>Follow the story</span>
        {topics.map((t) => <a href={topicPath(t.slug)}>All {t.name} stories →</a>)}
      </nav>
    )}
    <RelatedGrid items={related} />
    <StoryNav section={{ name: category.data.name, href: categoryPath(category.id) }} more={more} newer={newer} older={older} />
    {endAd && <AdSlot unit={5} />}
  </article>
  <ArticleAside headings={headings} downloads={d.downloads.length} url={absNewsUrl(articlePath(article.id))} title={d.title} image={shareImage} related={related.slice(0,4)} />
  <ShareIcons />
  </div>
  <script is:inline>
    (() => {
      // Reading progress (transform only, no layout work), the current section in the sidebar and
      // the section bar. The bar shows once the first section heading passes under the header and
      // hides after the story body; the current section is the last heading above 30% of the screen.
      const bar = document.querySelector(".progress span"), body = document.querySelector(".prose-news");
      const sb = document.querySelector("[data-secbar]"), head = document.querySelector(".site-header-bar");
      const heads = [...document.querySelectorAll("[data-toc]")].map((a) => document.getElementById(a.dataset.toc)).filter(Boolean);
      const marks = (sel, key) => new Map([...document.querySelectorAll(sel)].map((a) => [a.dataset[key], a]));
      const side = marks("[data-toc]", "toc"), list = marks("[data-sec]", "sec");
      const sbBtn = sb?.querySelector(".secbar-btn"), sbList = sb?.querySelector(".secbar-list");
      let cur = -1;
      const close = () => { if (sbList && !sbList.hidden) { sbList.hidden = true; sbBtn.setAttribute("aria-expanded", "false"); } };
      const tick = () => {
        const r = body.getBoundingClientRect(), h = r.height - innerHeight;
        bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, h > 0 ? -r.top / h : 1)) + ")";
        if (!heads.length) return;
        const top = head ? head.getBoundingClientRect().bottom : 0;
        let i = -1;
        for (let k = 0; k < heads.length && heads[k].getBoundingClientRect().top < innerHeight * 0.3; k++) i = k;
        if (i !== cur) {
          cur = i;
          for (const m of [side, list]) m.forEach((a) => a.classList.remove("on"));
          const id = heads[Math.max(i, 0)].id;
          side.get(id)?.classList.add("on"); list.get(id)?.classList.add("on");
          if (sb) { sb.querySelector("[data-secbar-n]").textContent = Math.max(i, 0) + 1 + "/" + heads.length; sb.querySelector("[data-secbar-t]").textContent = side.get(id)?.textContent ?? ""; }
        }
        if (sb) {
          sb.style.setProperty("--secbar-top", Math.max(0, top) + "px");
          const show = heads[0].getBoundingClientRect().top < top + 8 && r.bottom > top + 120;
          if (show !== sb.classList.contains("show")) { sb.classList.toggle("show", show); if (!show) close(); }
        }
      };
      addEventListener("scroll", () => requestAnimationFrame(tick), { passive: true }); addEventListener("resize", tick); tick();
      if (sb) {
        sbBtn.addEventListener("click", () => { const open = sbList.hidden; sbList.hidden = !open; sbBtn.setAttribute("aria-expanded", String(open)); });
        sbList.addEventListener("click", (e) => { if (e.target.closest("a")) close(); });
        document.addEventListener("click", (e) => { if (!sb.contains(e.target)) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !sbList.hidden) { close(); sbBtn.focus(); } });
      }
      for (const b of document.querySelectorAll(".share .copy")) b.addEventListener("click", async () => {
        const lbl = b.querySelector(".lbl"), use = b.querySelector("use");
        try { await navigator.clipboard.writeText(b.dataset.url); lbl.textContent = "Link copied"; use.setAttribute("href", "#si-check"); b.classList.add("done"); setTimeout(() => { lbl.textContent = "Copy link"; use.setAttribute("href", "#si-link"); b.classList.remove("done"); }, 2000); } catch { prompt("Copy this link:", b.dataset.url); }
      });
      if (navigator.share) for (const b of document.querySelectorAll(".share .native")) { b.hidden = false; b.addEventListener("click", () => navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(() => {})); }
      const AB = { AL: "Alabama", AK: "Alaska", AZ: "Arizona", AR: "Arkansas", CA: "California", CO: "Colorado", CT: "Connecticut", DE: "Delaware", DC: "District of Columbia", FL: "Florida", GA: "Georgia", HI: "Hawaii", ID: "Idaho", IL: "Illinois", IN: "Indiana", IA: "Iowa", KS: "Kansas", KY: "Kentucky", LA: "Louisiana", ME: "Maine", MD: "Maryland", MA: "Massachusetts", MI: "Michigan", MN: "Minnesota", MS: "Mississippi", MO: "Missouri", MT: "Montana", NE: "Nebraska", NV: "Nevada", NH: "New Hampshire", NJ: "New Jersey", NM: "New Mexico", NY: "New York", NC: "North Carolina", ND: "North Dakota", OH: "Ohio", OK: "Oklahoma", OR: "Oregon", PA: "Pennsylvania", RI: "Rhode Island", SC: "South Carolina", SD: "South Dakota", TN: "Tennessee", TX: "Texas", UT: "Utah", VT: "Vermont", VA: "Virginia", WA: "Washington", WV: "West Virginia", WI: "Wisconsin", WY: "Wyoming" };
      // ZIP finder (sample ballot story): the first three ZIP digits give the state (USPS prefixes),
      // then the matching row of the server-rendered state table supplies the official lookup link.
      const zf = document.querySelector("[data-zip-finder]");
      if (zf) {
        const R = "005-005NY,010-027MA,028-029RI,030-038NH,039-049ME,050-054VT,055-055MA,056-059VT,060-069CT,070-089NJ,100-149NY,150-196PA,197-199DE,200-200DC,201-201VA,202-205DC,206-219MD,220-246VA,247-268WV,270-289NC,290-299SC,300-319GA,320-339FL,341-349FL,350-369AL,370-385TN,386-397MS,398-399GA,400-427KY,430-459OH,460-479IN,480-499MI,500-528IA,530-549WI,550-567MN,569-569DC,570-577SD,580-588ND,590-599MT,600-629IL,630-658MO,660-679KS,680-693NE,700-714LA,716-729AR,730-732OK,733-733TX,734-749OK,750-799TX,800-816CO,820-831WY,832-838ID,840-847UT,850-865AZ,870-884NM,885-885TX,889-898NV,900-961CA,967-968HI,970-979OR,980-994WA,995-999AK"
          .split(",").map((s) => [+s.slice(0, 3), +s.slice(4, 7), AB[s.slice(7)]]);
        const out = zf.querySelector(".zip-out"), input = zf.querySelector("input");
        const rows = [...document.querySelectorAll(".prose-news tbody tr")];
        zf.addEventListener("submit", (ev) => {
          ev.preventDefault();
          rows.forEach((r) => r.classList.remove("zip-hit"));
          const z = input.value.trim();
          if (!/^\d{5}$/.test(z)) { out.textContent = "Enter a five-digit ZIP code."; return; }
          const p = +z.slice(0, 3), st = R.find(([a, b]) => p >= a && p <= b)?.[2];
          const row = st && rows.find((r) => r.cells[0]?.textContent.trim() === st);
          if (!row) { out.textContent = "We could not match ZIP " + z + " to a state. Pick your state in the table below."; return; }
          out.replaceChildren(document.createTextNode("ZIP " + z + " is in " + st + ". Official lookup: "), ...[...row.cells[1].childNodes].map((n) => n.cloneNode(true)), document.createTextNode(" · Sample ballots: " + row.cells[2].textContent.trim() + ". "));
          const jump = document.createElement("a"); jump.href = "#"; jump.textContent = "See the row"; jump.addEventListener("click", (e) => { e.preventDefault(); row.scrollIntoView({ block: "center" }); }); out.append(jump);
          row.classList.add("zip-hit");
        });
      }

      // Story tools. Each one reads its facts from the story itself (table rows, list items or data-*
      // attributes written next to the source text), starts hidden and only appears when this script
      // runs, so the page reads the same without JavaScript. Dates count in Eastern Time.
      const todayET = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(new Date());
      const MON = ["Jan.", "Feb.", "March", "April", "May", "June", "July", "Aug.", "Sept.", "Oct.", "Nov.", "Dec."];
      const WD = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      const WD_AP = ["Sun.", "Mon.", "Tue.", "Wed.", "Thu.", "Fri.", "Sat."];
      const daysFrom = (iso) => Math.round((Date.parse(iso) - Date.parse(todayET)) / 864e5);
      const apDate = (iso, wd = true) => { const d = new Date(iso + "T12:00:00Z"); return (wd ? WD[d.getUTCDay()] + ", " : "") + MON[d.getUTCMonth()] + " " + d.getUTCDate(); };
      const inDays = (n) => (n === 0 ? "today" : n === 1 ? "tomorrow" : "in " + n + " days");
      const show = (el) => { el.hidden = false; return el; };
      // Markdown tables sit in a .table-scroll box (src/lib/table-scroll.mjs); sibling walks step into it.
      const unwrap = (el) => (el?.matches(".table-scroll") ? el.querySelector("table") : el);

      // Days-until column: the table after [data-days-until] gets a live "Days from today" column.
      for (const el of document.querySelectorAll("[data-days-until]")) {
        let t = el.nextElementSibling;
        while (t && !t.matches("table, .table-scroll")) t = t.nextElementSibling;
        t = unwrap(t);
        if (!t || !t.tHead || !t.tBodies[0]) continue;
        const year = +el.dataset.daysUntil, last = t.tHead.rows[0].cells.length - 1;
        t.tHead.rows[0].cells[last].textContent = "Days from today";
        let next = null;
        for (const r of t.tBodies[0].rows) {
          const m = /^([A-Z][a-z]+)\.? (\d{1,2})\b/.exec(r.cells[0].textContent.trim());
          const mi = m ? MON.findIndex((x) => x.startsWith(m[1].slice(0, 3))) : -1;
          if (mi < 0) continue;
          const n = daysFrom(year + "-" + String(mi + 1).padStart(2, "0") + "-" + m[2].padStart(2, "0"));
          r.cells[last].textContent = n < 0 ? "Passed" : n === 0 ? "Today" : String(n);
          r.classList.toggle("is-past", n < 0);
          if (n >= 0 && !next) { next = r; r.classList.add("is-next"); }
        }
        show(el).textContent = "Counting from today, " + apDate(todayET) + ", Eastern Time." + (next ? " Next up: " + next.cells[2].textContent.trim() + " (" + next.cells[0].textContent.trim() + ")." : "");
      }

      // Social Security payday: dates come from the form's data-* lists (SSA's 2026 schedule).
      const sp = document.querySelector("[data-ssa-payday]");
      if (sp) {
        const day = sp.querySelector("#ssa-day"), kind = sp.querySelector("#ssa-kind"), out = sp.querySelector(".tool-out");
        for (let i = 1; i <= 31; i++) day.add(new Option(String(i), String(i)));
        const list = (k) => (sp.dataset[k] || "").split(",").filter(Boolean);
        const line = (label, dates) => {
          const left = dates.filter((d) => daysFrom(d) >= 0);
          if (!left.length) return label + ": no more dates in this schedule.";
          const [n, ...rest] = left;
          return label + ": " + apDate(n) + ", " + inDays(daysFrom(n)) + (rest.length ? ". After that: " + rest.map((d) => apDate(d, false)).join(", ") : "") + ".";
        };
        const run = () => {
          const k = kind.value, d = +day.value;
          // Only the post-1997 Wednesday schedule depends on the birthday; hide the field otherwise.
          day.hidden = day.labels[0].hidden = k !== "new";
          const g = d <= 10 ? "w2" : d <= 20 ? "w3" : "w4";
          const lines = k === "new" ? [line("Your next payment", list(g))]
            : k === "old" ? [line("Your next payment", list("ss3"))]
            : k === "both" ? [line("Social Security", list("ss3")), line("SSI", list("ssi"))]
            : [line("Your next SSI payment", list("ssi"))];
          out.replaceChildren(...lines.map((t) => Object.assign(document.createElement("p"), { textContent: t })));
        };
        day.value = "1"; day.addEventListener("change", run); kind.addEventListener("change", run); run(); show(sp);
      }

      // State finder: every table row and list item in the story that names the chosen state.
      const sf = document.querySelector("[data-state-finder]");
      if (sf) {
        const sel = sf.querySelector("select"), out = sf.querySelector(".tool-out");
        for (const n of Object.values(AB).sort()) sel.add(new Option(n, n));
        const body = document.querySelector(".prose-news");
        const names = (text, st) => {
          const t = st === "Virginia" ? text.replace(/West Virginia/g, "") : text;
          return new RegExp("(^|[^A-Za-z])" + st + "(?![A-Za-z])").test(t);
        };
        const section = (el) => { let h = el.closest(".table-scroll") ?? el.closest("table, ul, ol"); while (h && !/^H[23]$/.test(h.tagName)) h = h.previousElementSibling; return h ? h.textContent.trim() : ""; };
        sel.addEventListener("change", () => {
          body.querySelectorAll(".zip-hit").forEach((r) => r.classList.remove("zip-hit"));
          const st = sel.value; if (!st) { out.replaceChildren(); return; }
          const hits = [];
          for (const r of body.querySelectorAll("tbody tr")) {
            const i = [...r.cells].findIndex((c) => names(c.textContent, st));
            if (i < 0) continue;
            const head = r.closest("table").tHead?.rows[0].cells;
            // Leave out the cell that names the state; the other cells, with their headers, are the answer.
            const parts = [...r.cells].map((c, j) => [c, j]).filter(([, j]) => j !== i || r.cells.length === 1).map(([c, j]) => (head ? head[j].textContent.trim() + ": " : "") + c.textContent.trim());
            // The column headers already say what the row is, so table hits skip the section title.
            hits.push(["", parts.join(" · "), r]); r.classList.add("zip-hit");
          }
          for (const li of body.querySelectorAll("li")) if (!li.closest("nav, form") && names(li.textContent, st)) hits.push([section(li), li.textContent.trim(), li]);
          if (!hits.length) { out.replaceChildren(Object.assign(document.createElement("p"), { textContent: (sf.dataset.none || "This story does not list {state}. Check your state election office.").replace("{state}", st) })); return; }
          out.replaceChildren(...hits.map(([sec, txt, el]) => {
            const p = document.createElement("p");
            if (sec) p.append(Object.assign(document.createElement("b"), { textContent: sec + ": " }));
            const a = Object.assign(document.createElement("a"), { href: "#", textContent: "see it" });
            a.addEventListener("click", (e) => { e.preventDefault(); el.scrollIntoView({ block: "center" }); });
            p.append(txt + " (", a, ")");
            return p;
          }));
        });
        show(sf);
      }

      // Time difference by day: offsets come from the browser's own time zone data at noon UTC.
      const tg = document.querySelector("[data-tz-gap]");
      if (tg) {
        const off = (tz, d) => (new Date(d.toLocaleString("en-US", { timeZone: tz })) - new Date(d.toLocaleString("en-US", { timeZone: "UTC" }))) / 36e5;
        const gap = (d) => off("Europe/London", d) - off("America/New_York", d);
        const hm = (h) => { const x = ((h % 24) + 24) % 24; return (x % 12 || 12) + " " + (x < 12 ? "a.m." : "p.m."); };
        const rows = [];
        for (let d = new Date(tg.dataset.from + "T12:00:00Z"); d <= new Date(tg.dataset.to + "T12:00:00Z"); d = new Date(+d + 864e5)) {
          const iso = d.toISOString().slice(0, 10), g = gap(d);
          const d0 = new Date(iso + "T12:00:00Z");
          rows.push("<tr" + (iso === todayET ? ' class="is-next"' : "") + "><td>" + WD_AP[d0.getUTCDay()] + ", " + apDate(iso, false) + "</td><td>" + g + " hours</td><td>" + hm(9 + g) + "</td></tr>");
        }
        tg.querySelector(".tool-out").innerHTML = "<p>Right now London is <b>" + gap(new Date()) + " hours</b> ahead of New York.</p><div class='table-scroll'><table><thead><tr><th>Date</th><th>London ahead</th><th>9 a.m. New York</th></tr></thead><tbody>" + rows.join("") + "</tbody></table></div>";
        show(tg);
      }

      // Launch clock: a live countdown to one of the moments listed in data-targets ("label|ISO instant;...",
      // facts copied from the story's sources). An entry with no instant means local midnight on data-local
      // (an assumption, labeled as one). Shows the target in the reader's own time zone. Stops at zero.
      const lc = document.querySelector("[data-launch-clock]");
      if (lc) {
        const sel = lc.querySelector("select"), out = lc.querySelector(".tool-out");
        const items = lc.dataset.targets.split(";").map((s) => s.split("|"));
        const at = ([, iso]) => (iso ? new Date(iso) : new Date(+lc.dataset.local.slice(0, 4), +lc.dataset.local.slice(5, 7) - 1, +lc.dataset.local.slice(8, 10)));
        items.forEach(([label], i) => sel.add(new Option(label, String(i))));
        const own = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" });
        const digits = Object.assign(document.createElement("p"), { className: "lc-digits" });
        digits.setAttribute("role", "timer");
        const when = document.createElement("p");
        out.replaceChildren(digits, when);
        let timer;
        const tick = () => {
          const ms = at(items[+sel.value]) - Date.now();
          if (ms <= 0) { digits.textContent = lc.dataset.done; digits.classList.add("lc-done"); clearInterval(timer); return; }
          const s = Math.floor(ms / 1e3), cell = (n, u) => "<span><b>" + String(n).padStart(2, "0") + "</b>" + u + "</span>";
          digits.innerHTML = cell(Math.floor(s / 86400), "days") + cell(Math.floor(s / 3600) % 24, "hours") + cell(Math.floor(s / 60) % 60, "minutes") + cell(s % 60, "seconds");
        };
        const run = () => {
          digits.classList.remove("lc-done"); clearInterval(timer);
          when.textContent = "That moment is " + own.format(at(items[+sel.value])) + " in your time zone.";
          tick(); timer = setInterval(tick, 1000);
        };
        sel.addEventListener("change", run); run(); show(lc);
      }

      // Season schedule (NFL story): each "Week N" H3 is followed by a table of Day | Kickoff (ET) | Game | TV.
      // Kickoffs become instants (EDT before Nov. 1, EST after; the season ends before March), past games
      // dim, the next one is marked, and [data-nfl-team] lists one team's weeks with the reader's own time,
      // the team's PDF from data-pdf and an .ics file of the dated games. "Not set" rows stay undated.
      const nt = document.querySelector("[data-nfl-team]");
      if (nt) {
        const body = document.querySelector(".prose-news"), out = nt.querySelector(".tool-out"), sel = nt.querySelector("select");
        const year0 = +nt.dataset.year;
        const at = (day, time) => {
          const d = /([A-Z][a-z]+)\.? (\d{1,2})/.exec(day), t = /^(\d{1,2})(?::(\d\d))? ([ap])\.m\./.exec(time);
          if (!d || !t) return null;
          const m = MON.findIndex((x) => x.startsWith(d[1].slice(0, 3))), y = m < 6 ? year0 + 1 : year0;
          const h = (+t[1] % 12) + (t[3] === "p" ? 12 : 0), off = y === year0 && m < 10 ? 4 : 5;
          return new Date(Date.UTC(y, m, +d[2], h + off, +(t[2] || 0)));
        };
        const weeks = [];
        for (const h of body.querySelectorAll("h3")) {
          const wm = /^Week (\d+)/.exec(h.textContent.trim());
          let t = h.nextElementSibling;
          while (t && !t.matches("table, .table-scroll, h2, h3")) t = t.nextElementSibling;
          t = unwrap(t);
          if (!wm || !t || !t.matches("table")) continue;
          const games = [...t.tBodies[0].rows].map((r) => ({ week: +wm[1], day: r.cells[0].textContent.trim(), time: r.cells[1].textContent.trim(), game: r.cells[2].textContent.trim(), tv: r.cells[3].textContent.trim(), row: r }));
          games.forEach((g) => (g.at = at(g.day, g.time)));
          weeks.push({ n: +wm[1], h, games });
        }
        const all = weeks.flatMap((w) => w.games), now = Date.now();
        // A game counts as played four hours after kickoff.
        const next = all.filter((g) => g.at && +g.at + 4 * 36e5 > now).sort((a, b) => a.at - b.at)[0];
        for (const g of all) if (g.at && +g.at + 4 * 36e5 <= now) g.row.classList.add("is-past");
        if (next) next.row.classList.add("is-next");
        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone, sameZone = zone === "America/New_York";
        const local = (d) => d.toLocaleString("en-US", { hour: "numeric", minute: "2-digit", timeZoneName: "short" }).replace(":00", "").replace("AM", "a.m.").replace("PM", "p.m.");
        const localDay = (d) => d.toLocaleString("en-US", { weekday: "short", month: "short", day: "numeric" });
        const el = (tag, props, ...kids) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
        const jump = (row, text) => el("a", { href: "#", textContent: text, onclick: (e) => { e.preventDefault(); row.scrollIntoView({ block: "center" }); } });
        const status = el("p", {});
        if (next) {
          const n = daysFrom(new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(next.at));
          status.append("Today is " + apDate(todayET) + ". Next kickoff: ", el("b", { textContent: next.game }), ", Week " + next.week + ", " + next.day + " at " + next.time + " ET" + (sameZone ? "" : " (" + local(next.at) + ")") + ", " + inDays(n) + ". ", jump(next.row, "Show it in the schedule"));
        } else status.textContent = "The regular season is over.";
        const teams = nt.dataset.teams.split(";").map((s) => s.split("|"));
        for (const [name] of teams) sel.add(new Option(name, name));
        const run = () => {
          const name = sel.value, kids = [status];
          if (name) {
            const nick = name.split(" ").pop(), re = new RegExp("(^|[^A-Za-z0-9])" + nick + "(?![A-Za-z])");
            const div = teams.find(([n]) => n === name)[1];
            const rows = weeks.map((w) => ({ w: w.n, g: w.games.find((g) => re.test(g.game)) }));
            const bye = rows.find((r) => !r.g)?.w;
            const opp = (g) => {
              const m = /^(.+?) (at|vs\.) (.+?)(?: \((.+)\))?$/.exec(g.game);
              if (!m) return g.game;
              const mine = m[1] === nick, other = mine ? m[3] : m[1];
              return m[4] ? "vs. " + other + " in " + m[4] : mine ? "at " + other : "vs. " + other;
            };
            const mineNext = rows.map((r) => r.g).find((g) => g && g.at && +g.at + 4 * 36e5 > now);
            const sum = el("p", {}, el("b", { textContent: name }), " (" + div + "). Bye: Week " + bye + ". ");
            if (mineNext) sum.append("Next game: " + opp(mineNext) + ", " + mineNext.day + " at " + mineNext.time + " ET" + (sameZone ? "" : " (" + local(mineNext.at) + ")") + (mineNext.tv && mineNext.tv !== "Not set" ? " on " + mineNext.tv : "") + ", " + inDays(daysFrom(new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(mineNext.at))) + ".");
            else sum.append("No dated games left; check the weeks marked Not set.");
            const head = ["Week", "Date", "Opponent", "Kickoff (ET)"].concat(sameZone ? [] : ["Your time"], ["TV"]);
            const tb = el("tbody", {});
            for (const r of rows) {
              const g = r.g, tr = el("tr", {});
              if (!g) { tr.append(el("td", { textContent: String(r.w) }), el("td", { textContent: "Bye week", colSpan: head.length - 1 })); tr.className = "is-bye"; }
              else {
                tr.append(...[String(r.w), g.day, opp(g), g.time].concat(sameZone ? [] : [g.at ? localDay(g.at) + ", " + local(g.at) : "Not set"], [g.tv]).map((t) => el("td", { textContent: t })));
                if (g === mineNext) tr.className = "is-next"; else if (g.at && +g.at + 4 * 36e5 <= now) tr.className = "is-past";
              }
              tb.append(tr);
            }
            const table = el("table", {}, el("thead", {}, el("tr", {}, ...head.map((t) => el("th", { textContent: t })))), tb);
            const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
            const dated = rows.map((r) => r.g).filter((g) => g && g.at);
            const stamp = (d) => d.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
            const ics = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Fresh Calendars//NFL 2026//EN", "CALSCALE:GREGORIAN", "X-WR-CALNAME:" + name + " 2026"]
              .concat(...dated.map((g) => ["BEGIN:VEVENT", "UID:nfl2026-w" + g.week + "-" + slug + "@freshcalendars.com", "DTSTAMP:" + stamp(new Date()), "DTSTART:" + stamp(g.at), "DURATION:PT3H30M", "SUMMARY:" + g.game, "DESCRIPTION:Week " + g.week + ". TV: " + g.tv + ". Kickoff times can change; check NFL.com. " + location.href.split("#")[0], "END:VEVENT"]), ["END:VCALENDAR"]).join("\r\n");
            const icsUrl = URL.createObjectURL(new Blob([ics], { type: "text/calendar" }));
            const btns = el("p", { className: "tool-btns" },
              el("a", { className: "tb-main", href: nt.dataset.pdf.replace("{slug}", slug), textContent: name + " schedule (PDF, 1 page)" }),
              el("a", { href: icsUrl, download: "2026-nfl-" + slug + "-schedule.ics", textContent: "Add " + dated.length + " games to my calendar (.ics)" }));
            const undated = rows.filter((r) => r.g && !r.g.at).length;
            kids.push(sum, table, btns);
            if (undated) kids.push(el("p", { className: "tool-note", textContent: undated + " game" + (undated === 1 ? " has" : "s have") + " no date or time yet, so the calendar file leaves " + (undated === 1 ? "it" : "them") + " out. Download it again once the NFL sets them." }));
          }
          out.replaceChildren(...kids);
          try { name ? localStorage.setItem("nfl-team", name) : localStorage.removeItem("nfl-team"); } catch {}
        };
        try { const saved = localStorage.getItem("nfl-team"); if (saved && teams.some(([n]) => n === saved)) sel.value = saved; } catch {}
        sel.addEventListener("change", run); run(); show(nt);
      }

      // Printable picker: data-files lists "what|paper|ink|pdf|pages|tip;..." for the story's downloads.
      // Each choice narrows the next one, so the reader only sees combinations that exist.
      const pp = document.querySelector("[data-pdf-picker]");
      if (pp) {
        const files = pp.dataset.files.split(";").map((s) => s.split("|"));
        const [what, paper, ink] = pp.querySelectorAll("select"), out = pp.querySelector(".tool-out");
        const fill = (s, vals) => { const keep = s.value; s.replaceChildren(...vals.map((v) => new Option(v, v))); if (vals.includes(keep)) s.value = keep; };
        const uniq = (a) => [...new Set(a)];
        fill(what, uniq(files.map((f) => f[0])));
        const run = () => {
          fill(paper, uniq(files.filter((f) => f[0] === what.value).map((f) => f[1])));
          fill(ink, uniq(files.filter((f) => f[0] === what.value && f[1] === paper.value).map((f) => f[2])));
          paper.disabled = paper.options.length < 2; ink.disabled = ink.options.length < 2;
          const f = files.find((x) => x[0] === what.value && x[1] === paper.value && x[2] === ink.value);
          out.replaceChildren(
            Object.assign(document.createElement("p"), { className: "tool-btns" }),
            Object.assign(document.createElement("p"), { textContent: f[5] }),
          );
          const b = out.firstChild;
          b.append(Object.assign(document.createElement("a"), { className: "tb-main", href: f[3], textContent: "Download PDF · " + f[4] + (f[4] === "1" ? " page" : " pages") + " · " + f[1] }),
            Object.assign(document.createElement("a"), { href: f[3].replace(/\.pdf$/, ".png"), textContent: "PNG preview of page 1" }));
        };
        for (const s of [what, paper, ink]) s.addEventListener("change", run);
        run(); show(pp);
      }

      // Spelling Bee tracker (src/lib/puzzle-boards.mjs): checks each typed word against the day's
      // list, keeps the score and saves the found words on this device for this puzzle date only.
      const bt = document.querySelector("[data-bee-tracker]");
      if (bt) {
        const words = bt.dataset.words.split(" "), pang = new Set(bt.dataset.pangrams.split(" "));
        const genius = +bt.dataset.genius, total = +bt.dataset.total, key = "fc-bee-" + bt.dataset.date;
        const pts = (w) => (w.length === 4 ? 1 : w.length) + (pang.has(w) ? 7 : 0);
        let found = [];
        try { found = JSON.parse(localStorage.getItem(key) || "[]").filter((w) => words.includes(w)); } catch {}
        const input = bt.querySelector("input"), out = bt.querySelector(".tool-out");
        const save = () => { try { localStorage.setItem(key, JSON.stringify(found)); } catch {} };
        const render = (msg) => {
          const score = found.reduce((s, w) => s + pts(w), 0);
          const left = words.filter((w) => !found.includes(w));
          const status = left.length === 0 ? "You found every word." : score >= genius ? "You reached Genius (" + genius + " points)." : "Genius needs " + genius + " points: " + (genius - score) + " to go.";
          const by = {};
          for (const w of left) by[w.slice(0, 2)] = (by[w.slice(0, 2)] || 0) + 1;
          const p = (t, cls) => Object.assign(document.createElement("p"), { textContent: t, className: cls || "" });
          out.replaceChildren(...[
            msg && p(msg),
            p(found.length + " of " + words.length + " words, " + score + " of " + total + " points. " + status),
            found.length ? p("Your words: " + [...found].sort().map((w) => w[0] + w.slice(1).toLowerCase()).join(", ")) : null,
            left.length ? p("Still to find, by first two letters: " + Object.keys(by).sort().map((k) => k[0] + k[1].toLowerCase() + " " + by[k]).join(" · "), "tool-note") : null,
          ].filter(Boolean));
        };
        bt.addEventListener("submit", (e) => {
          e.preventDefault();
          const w = input.value.toUpperCase().replace(/[^A-Z]/g, "");
          input.value = "";
          if (!w) return render();
          const nice = w[0] + w.slice(1).toLowerCase();
          if (found.includes(w)) return render(nice + " is already on your list.");
          if (!words.includes(w)) return render(nice + " is not in today's word list.");
          found.push(w); save();
          render(nice + " added, " + pts(w) + (pts(w) === 1 ? " point" : " points") + (pang.has(w) ? ". That is a pangram!" : "."));
        });
        bt.querySelector("[data-bee-reset]").addEventListener("click", () => { found = []; save(); render("Your list is cleared."); });
        render(); show(bt);
      }

      // Wordle used-word checker: every past answer in puzzle order, so a word's index is its number.
      const wc = document.querySelector("[data-wordle-check]");
      if (wc) {
        const answers = wc.dataset.answers.split(" "), first = wc.dataset.first;
        const input = wc.querySelector("input"), out = wc.querySelector(".tool-out");
        const dateOf = (n) => new Date(Date.parse(first + "T12:00:00Z") + n * 864e5).toISOString().slice(0, 10);
        wc.addEventListener("submit", (e) => {
          e.preventDefault();
          const w = input.value.toUpperCase().replace(/[^A-Z]/g, ""), nice = w && w[0] + w.slice(1).toLowerCase();
          if (w.length !== 5) { out.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Enter a five-letter word." })); return; }
          const hits = answers.flatMap((a, i) => (a === w ? [i] : []));
          const t = hits.length
            ? nice + " was the answer " + (hits.length === 1 ? "once" : hits.length === 2 ? "twice" : hits.length + " times") + ": " + hits.map((i) => "#" + i + " on " + apDate(dateOf(i)) + ", " + dateOf(i).slice(0, 4)).join("; ") + "."
            : nice + " has not been the answer in Wordle #0 to #" + (answers.length - 1) + ".";
          out.replaceChildren(Object.assign(document.createElement("p"), { textContent: t }));
        });
        show(wc);
      }
    })();
  </script>
</NewsBase>

