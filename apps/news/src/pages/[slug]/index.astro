---
import { getEntry, render } from "astro:content";
import NewsBase from "../../layouts/NewsBase.astro";
import AdSlot from "../../components/AdSlot.astro";
import ArticleMeta from "../../components/ArticleMeta.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CalendarLinks from "../../components/CalendarLinks.astro";
import DownloadGrid from "../../components/DownloadGrid.astro";
import Corrections from "../../components/Corrections.astro";
import Faq from "../../components/Faq.astro";
import Hero from "../../components/Hero.astro";
import KeyPoints from "../../components/KeyPoints.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import Sources from "../../components/Sources.astro";
import Toc from "../../components/Toc.astro";
import ArticleAside from "../../components/ArticleAside.astro";
import ShareBar from "../../components/ShareBar.astro";
import { authorHref, getPublishedArticles, lastModified, type Article } from "../../lib/articles";
import { heroImages } from "../../lib/images";
import { SITE_ORIGIN, absNewsUrl } from "../../lib/site";
import { pickRelated } from "../../lib/related";
import {
  articleGraph,
  articleHeadTags,
  articlePath,
  categoryPath,
  countWords,
  pageTitle,
  readingMinutes,
  type ArticleSeo,
  type AuthorSeo,
} from "../../lib/seo";

export async function getStaticPaths() {
  const all = await getPublishedArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);

const category = (await getEntry(d.category))!;
const authors = await Promise.all(d.authors.map(async (ref) => (await getEntry(ref))!));
const authorPath = authorHref;

const hero = await heroImages(d.hero.src);

const wordCount = countWords(article.body ?? "");
const minutes = readingMinutes(wordCount);
const modifiedAt = lastModified(article);

const authorSeo: AuthorSeo[] = authors.map((a) => ({
  kind: a.data.kind,
  name: a.data.name,
  path: authorPath(a.id),
  role: a.data.role,
  sameAs: a.data.sameAs,
}));

const seo: ArticleSeo = {
  slug: article.id,
  title: d.title,
  seoTitle: d.seoTitle,
  description: d.description,
  type: d.type,
  publishedAt: d.publishedAt,
  modifiedAt,
  authors: authorSeo,
  category: { slug: category.id, name: category.data.name },
  keywords: d.keywords,
  dateline: d.dateline,
  hero: {
    main: hero.main,
    crops: hero.crops,
    alt: d.hero.alt,
    title: d.hero.title ?? d.title,
    caption: d.hero.caption,
    credit: d.hero.credit,
  },
  wordCount,
  readingMinutes: minutes,
  downloads: d.downloads.map((x) => ({ name: x.title, description: x.description, pdf: `${SITE_ORIGIN}${x.pdf}`, png: `${SITE_ORIGIN}${x.png}` })),
};

const related = pickRelated(
  { id: article.id, category: category.id, keywords: d.keywords, publishedAt: d.publishedAt },
  all.map((a) => ({ id: a.id, category: a.data.category.id, keywords: a.data.keywords, publishedAt: a.data.publishedAt, a })),
  d.related.map((r) => r.id),
).map(({ a }) => ({
  href: articlePath(a.id),
  title: a.data.title,
  image: a.data.hero.src,
  alt: a.data.hero.alt,
  publishedAt: a.data.publishedAt,
}));
---
<NewsBase
  title={pageTitle(d)}
  description={d.description}
  path={articlePath(article.id)}
  ogType="article"
  robots={d.noindex ? "noindex, follow" : undefined}
  headTags={articleHeadTags(seo)}
  jsonLd={articleGraph(seo)}
>
  <div class="progress" aria-hidden="true"><span></span></div>
  <div class="article-layout">
  <article class="news-wrap article">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "News", href: "/news/" },
      { name: category.data.name, href: categoryPath(category.id) },
      { name: d.title },
    ]} />
    <AdSlot unit={5} variant="top" />
    <p class="kicker"><a href={categoryPath(category.id)}>{category.data.name}</a></p>
    <h1>{d.title}</h1>
    <p class="news-lede">{d.description}</p>
    <ArticleMeta
      authors={authors.map((a) => ({ name: a.data.name, href: authorPath(a.id) }))}
      publishedAt={d.publishedAt}
      modifiedAt={modifiedAt}
      readingMinutes={minutes}
      dateline={d.dateline}
    />
    <Hero src={d.hero.src} alt={d.hero.alt} title={d.hero.title ?? d.title} caption={d.hero.caption} credit={d.hero.credit} />
    <KeyPoints points={d.summary} />
    {d.downloads.length > 0 && <p class="jump"><a href="#downloads">{d.downloads.length} free printable{d.downloads.length === 1 ? "" : "s"} below ↓</a></p>}
    <Toc headings={headings} />
    <div class="prose-news">
      <Content />
    </div>
    <DownloadGrid items={d.downloads} />
    <div class="after">
      <ShareBar url={absNewsUrl(articlePath(article.id))} title={d.title} />
      <a class="top-link" href="#main">Back to top ↑</a>
    </div>
    <AdSlot unit={2} />
    <CalendarLinks links={d.internalLinks} />
    <Faq items={d.faq} />
    <Sources items={d.sources} />
    <Corrections items={d.corrections} />
    <AdSlot unit={4} />
    {authors.map((a) => (
      <AuthorCard name={a.data.name} role={a.data.role} bio={a.data.bio} href={authorPath(a.id)} />
    ))}
    <RelatedGrid items={related} />
  </article>
  <ArticleAside headings={headings} downloads={d.downloads.length} url={absNewsUrl(articlePath(article.id))} title={d.title} />
  </div>
  <script is:inline>
    (() => {
      // Reading progress (transform only, no layout work) and the current section in the sidebar.
      const bar = document.querySelector(".progress span"), body = document.querySelector(".prose-news");
      const tick = () => { const r = body.getBoundingClientRect(), h = r.height - innerHeight; bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, h > 0 ? -r.top / h : 1)) + ")"; };
      addEventListener("scroll", () => requestAnimationFrame(tick), { passive: true }); tick();
      const links = new Map([...document.querySelectorAll("[data-toc]")].map((a) => [a.dataset.toc, a]));
      if (links.size && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { links.forEach((a) => a.classList.remove("on")); links.get(e.target.id)?.classList.add("on"); } }, { rootMargin: "0px 0px -70% 0px" });
        links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
      }
      for (const b of document.querySelectorAll(".share .copy")) b.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(b.dataset.url); b.textContent = "Link copied"; b.classList.add("done"); setTimeout(() => { b.textContent = "Copy link"; b.classList.remove("done"); }, 2000); } catch { prompt("Copy this link:", b.dataset.url); }
      });
      if (navigator.share) for (const b of document.querySelectorAll(".share .native")) { b.hidden = false; b.addEventListener("click", () => navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(() => {})); }
    })();
  </script>
</NewsBase>

<style>
  .article .kicker{margin:0 0 .5rem;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
  .article .kicker a{color:var(--focus);text-decoration:none}
  .article .news-lede{margin-bottom:1rem}
  .jump{margin:-.5rem 0 1.25rem;font-weight:700}
  .jump a{display:inline-flex;align-items:center;min-height:44px}
  .prose-news{font-family:"Source Sans 3","Source Sans 3 Fallback",ui-sans-serif,system-ui,sans-serif;font-size:1.125rem;line-height:1.7;color:var(--ink-strong)}
  .prose-news :global(h2){font-family:Sora,"Sora Fallback",sans-serif;font-size:1.35rem;line-height:1.3;margin:2rem 0 .75rem;color:var(--ink-strong);scroll-margin-top:5rem}
  .prose-news :global(h3){font-family:Sora,"Sora Fallback",sans-serif;font-size:1.1rem;line-height:1.3;margin:1.5rem 0 .5rem;color:var(--ink-strong)}
  .prose-news :global(ul){padding-left:1.25rem;margin:0 0 1.1rem}
  .prose-news :global(li){margin:.35rem 0}
  .prose-news :global(th){background:var(--wash)}
  .prose-news :global(p){margin:0 0 1.1rem}
  .prose-news :global(a){color:var(--focus)}
  /* Wide tables scroll inside their own box instead of being clipped on phones. */
  .prose-news :global(table){width:100%;border-collapse:collapse;margin:0 0 1.25rem;font-size:1rem;display:block;overflow-x:auto}
  .prose-news :global(th),.prose-news :global(td){border:1px solid var(--line-soft);padding:.5rem;text-align:left}
  .article :global(section h2),.article :global(aside h2){font-family:Sora,"Sora Fallback",sans-serif;color:var(--ink-strong)}
  .article :global(section){margin:2rem 0}
  .progress{position:fixed;left:0;right:0;top:0;height:4px;z-index:70;pointer-events:none}
  .progress span{display:block;height:100%;background:var(--gold);transform:scaleX(0);transform-origin:0 50%}
  .after{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:1rem;margin:2rem 0 0;padding-top:1.25rem;border-top:1px solid var(--line-soft)}
  .top-link{display:inline-flex;align-items:center;min-height:44px;font-weight:700;margin-bottom:1.25rem}
  @media (min-width:1100px){
    .article-layout{display:grid;grid-template-columns:minmax(0,720px) 260px;gap:3.5rem;justify-content:center;width:min(1120px,calc(100% - 2rem));margin:0 auto}
    .article-layout > .article{width:auto;margin:0}
    .article-layout :global(.aside){padding-top:clamp(1.75rem,4vw,2.75rem)}
  }
  @media print{
    .progress,.after,:global(.aside),:global(.site-header),:global(.site-footer),:global(.ad-slot){display:none!important}
    .prose-news{font-size:11pt}
  }
</style>
