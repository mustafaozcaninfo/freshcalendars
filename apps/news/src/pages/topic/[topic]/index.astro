---
/**
 * Topic hub: every story on one running subject across categories, newest first, with the
 * topic's upcoming key dates (add to calendar) and its pillar story as "Start here".
 * CollectionPage + ItemList JSON-LD via ListingView. Older stories continue on /page/N/ (page/[page].astro).
 */
import ListingView from "../../../components/ListingView.astro";
import KeyDates from "../../../components/KeyDates.astro";
import PuzzleTable from "../../../components/PuzzleTable.astro";
import { getCategoryNames, type Article } from "../../../lib/articles";
import { upcomingFor } from "../../../lib/keydates";
import { articlePath } from "../../../lib/seo";
import { centralId } from "../../../lib/similarity";
import { topicPages } from "../../../lib/pages";
import type { Page } from "../../../lib/listing";
import { liveTopics, storyIndex } from "../../../lib/storygraph";
import { startId, topicPath, type Topic } from "../../../lib/topics";

export async function getStaticPaths() {
  return (await topicPages())
    .filter(({ page }) => page.page === 1)
    .map(({ topic, items, page, all }) => ({ params: { topic: topic.slug }, props: { topic, items, page, all } }));
}
interface Props { topic: Topic; items: Article[]; page: Page<Article>; all: Article[] }
const { topic, items, page, all } = Astro.props;
const path = topicPath(topic.slug);
const ix = storyIndex(all);
const startSlug = startId(topic, items.map((a) => ({ id: a.id, title: a.data.title, keywords: a.data.keywords })), (ids) => centralId(ix, ids));
const start = items.find((a) => a.id === startSlug);
const dates = upcomingFor(new Set(items.map((a) => a.id)));
const others = liveTopics(all).map((t) => t.topic).filter((t) => t.slug !== topic.slug);
---
<ListingView
  page={page}
  heading={`${topic.name}: All Stories and Key Dates`}
  intro={topic.description}
  description={topic.description}
  trail={[{ name: "News", path: "/news/" }, { name: topic.name, path }]}
  kind="CollectionPage"
  categoryNames={await getCategoryNames()}
  about={`${items.length} stories. A story joins this page when it covers ${topic.name}; the newest is first. Other topics: ${others.map((t) => t.name).join(", ")}.`}
>
  {start && (
    <p class="start"><span>Start here</span><a href={articlePath(start.id)}>{start.data.title}</a></p>
  )}
  {topic.guide && page.page === 1 && (
    <section class="guide" id="how-it-works">
      <h2>{topic.guide.heading}</h2>
      {topic.guide.paras.map((p) => <p>{p}</p>)}
    </section>
  )}
  <KeyDates dates={dates.slice(0, 8)} heading={`Coming up in ${topic.name}`} ics={`${path}dates.ics`} linkStories />
  {topic.puzzle && <PuzzleTable stories={items.map((a) => ({ id: a.id, title: a.data.title }))} name={topic.name.replace(/ Answers.*$/, "")} />}
  {others.length > 0 && (
    <nav class="topics" aria-label="Other topics">
      {others.map((t) => <a href={topicPath(t.slug)}>{t.name}</a>)}
    </nav>
  )}
</ListingView>
<style>
  .start{display:grid;gap:.2rem;margin:0 0 1rem;padding:1rem 1.1rem;border:1px solid color-mix(in srgb,var(--accent) 22%,var(--line));background:var(--surface-tint);border-radius:var(--r-lg)}
  .start span{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--focus)}
  .start a{font-family:Sora,"Sora Fallback",sans-serif;font-weight:600;letter-spacing:-.015em;line-height:1.3;color:var(--ink-strong);text-decoration:none}
  .start a:hover,.start a:focus-visible{color:var(--accent)}
  .guide{margin:0 0 1.25rem;padding:1.1rem 1.2rem;border:1px solid var(--line-soft);border-radius:var(--r-lg)}
  .guide h2{margin:0 0 .5rem;font-size:1.15rem}
  .guide p{margin:.5rem 0 0;line-height:1.55}
  .topics{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 1.25rem}
  .topics a{display:inline-flex;align-items:center;min-height:44px;padding:0 .9rem;border:1px solid var(--line-soft);border-radius:999px;color:var(--ink-strong);text-decoration:none;font-weight:600;font-size:.9rem}
  .topics a:hover,.topics a:focus-visible{border-color:var(--line);background:var(--surface-soft)}
</style>
