---
/**
 * /news/404.html — nginx error_page for /news/ so missing stories keep the short news TTL.
 * A dead end costs the reader, so the page offers the newest reported stories, every section
 * and the busiest topics. Built with the site, so the lists follow each publish.
 */
import NewsBase from "../layouts/NewsBase.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categoryHref, getActiveCategories, getCategoryNames, getPublishedArticles } from "../lib/articles";
import { liveTopics } from "../lib/storygraph";
import { topicPath } from "../lib/topics";

const all = await getPublishedArticles();
const names = await getCategoryNames();
const categories = await getActiveCategories(all);
// Reported stories first: the daily puzzle pages would otherwise fill the list.
const latest = all.filter((a) => a.data.category.id !== "puzzles").slice(0, 6);
const topics = liveTopics(all).slice(0, 8).map(({ topic, items }) => ({ ...topic, count: items.length }));
---
<NewsBase ads={false} design="news-error"
  title="Story not found | Fresh Calendars News"
  description="This news story is not available. Browse the latest calendar and holiday news from the Fresh Calendars News Desk."
  path="/news/404.html"
  robots="noindex, follow"
>
  <div class="concept-wrap nf">
    <section class="error-page"><div class="error-visual" aria-hidden="true"><strong>404</strong></div><div class="error-content"><p class="overline">Fresh Calendars News</p><h1>Story not found</h1><p>This page may have moved, or the story is not published yet. The newest stories, every section and our free printables are below, or use the search at the top.</p><div class="error-links"><a href="/news/">Latest stories</a><a href="/news/printables/">Free printables</a><a href="/page/contact/">Report a broken link</a></div></div></section>

    {latest.length > 0 && (
      <section class="nf-block" aria-labelledby="nf-latest">
        <div class="nf-head"><h2 id="nf-latest">Latest stories</h2><a href="/news/">All news →</a></div>
        <div class="nf-tiles">{latest.map((a) => <ArticleCard article={a} categoryName={names.get(a.data.category.id) ?? ""} headingLevel={3} tile />)}</div>
      </section>
    )}

    <div class="nf-browse">
      <nav class="nf-block" aria-labelledby="nf-sections">
        <div class="nf-head"><h2 id="nf-sections">Browse by section</h2></div>
        <ul class="nf-chips">{categories.map((c) => <li><a href={categoryHref(c.id)}>{c.data.name}</a></li>)}</ul>
      </nav>
      {topics.length > 0 && (
        <nav class="nf-block" aria-labelledby="nf-topics">
          <div class="nf-head"><h2 id="nf-topics">Popular topics</h2></div>
          <ul class="nf-chips">{topics.map((t) => <li><a href={topicPath(t.slug)}>{t.name} <span>{t.count}</span></a></li>)}</ul>
        </nav>
      )}
    </div>
  </div>
</NewsBase>
<style>
  .nf{padding-bottom:3rem}
  .nf .error-page{min-height:0;padding:48px 0 40px}
  .nf .error-content>p{font-size:15px;color:var(--ink)}
  /* The shared error links are sized for the calendar site; here they are the page's main actions. */
  .nf .error-links a{min-height:44px;padding:10px 16px;font-size:14px;font-weight:700;border-radius:8px}
  .nf .error-links a:hover,.nf .error-links a:focus-visible{border-color:var(--focus);text-decoration:underline}
  .nf .error-links a:first-child:hover,.nf .error-links a:first-child:focus-visible{background:var(--focus);border-color:var(--focus)}
  .nf-block{margin:0 0 2.25rem}
  .nf-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;border-bottom:3px solid var(--ink-strong);margin-bottom:1rem}
  .nf-head h2{font:700 1.15rem/1.3 Sora,"Sora Fallback",sans-serif;color:var(--ink-strong);margin:0 0 .4rem}
  .nf-head a{font-weight:700;font-size:.92rem;text-decoration:none;padding:.5rem 0}
  .nf-tiles{display:grid;gap:1.25rem}
  .nf-browse{display:grid;gap:0 2.5rem}
  .nf-chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}
  .nf-chips a{display:inline-flex;align-items:center;gap:.45rem;min-height:44px;padding:0 1rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink-strong)!important;font-weight:700;font-size:.9rem;text-decoration:none}
  .nf-chips a:hover,.nf-chips a:focus-visible{border-color:var(--focus);color:var(--focus)!important}
  .nf-chips span{font-size:.78rem;font-weight:700;color:var(--ink);background:var(--surface-soft);border-radius:999px;padding:.05rem .45rem}
  @media (min-width:700px){.nf-tiles{grid-template-columns:repeat(3,1fr)}}
  @media (min-width:960px){.nf-browse{grid-template-columns:1fr 1fr}}
  @media (max-width:700px){.nf .error-page{padding:28px 0}}
</style>
