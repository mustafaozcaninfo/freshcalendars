---
/** Free printables hub: every PDF/PNG template from News stories, filterable by topic and text. */
import { Image } from "astro:assets";
import NewsBase from "../../layouts/NewsBase.astro";
import AdSlot from "../../components/AdSlot.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getActiveCategories, getCategoryNames, getPublishedArticles } from "../../lib/articles";
import { allPrintables, PRINTABLES_PATH } from "../../lib/printables";
import { listingGraph } from "../../lib/seo";

const articles = (await getPublishedArticles()).filter((a) => a.data.downloads.length > 0);
const items = allPrintables(articles);
const names = await getCategoryNames();
const topics = (await getActiveCategories(articles)).map((c) => ({ id: c.id, name: c.data.name, n: items.filter((i) => i.article.category === c.id).length }));
const title = "Free Printable Calendars, Charts and Trackers";
const description = `${items.length} free printable PDF and PNG templates from Fresh Calendars News: Ramadan, moon phases, week numbers, Social Security and more. No sign-up.`;
const jsonLd = listingGraph({
  path: PRINTABLES_PATH,
  name: title,
  description,
  trail: [{ name: "News", path: "/news/" }, { name: "Free printables", path: PRINTABLES_PATH }],
  items: articles.map((a) => ({ path: `/news/${a.id}/`, name: a.data.title })),
  kind: "CollectionPage",
});
---
<NewsBase title={`${title} | Fresh Calendars`} description={description} path={PRINTABLES_PATH} jsonLd={jsonLd}>
  <div class="hub">
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "News", href: "/news/" }, { name: "Free printables" }]} />
    <AdSlot unit={5} variant="top" />
    <h1>{title}</h1>
    <p class="news-lede">Every template from our stories in one place: {items.length} free PDFs and PNGs on US Letter paper, made by Fresh Calendars. No account, no email.</p>

    <div class="tools">
      <label class="q" for="pr-q"><span>Find a printable</span><input id="pr-q" type="search" placeholder="Try “moon”, “tracker” or “2027”" autocomplete="off" /></label>
      <div class="topics" role="group" aria-label="Filter by topic">
        <button type="button" data-topic="" aria-pressed="true">All<span>{items.length}</span></button>
        {topics.map((t) => <button type="button" data-topic={t.id} aria-pressed="false">{t.name}<span>{t.n}</span></button>)}
      </div>
      <p class="count" id="pr-count" aria-live="polite">{items.length} printables</p>
    </div>

    {articles.map((a, n) => (
      <>
      {(n === 3 || n === 8) && <AdSlot unit={n === 3 ? 3 : 2} />}
      <section class="story" data-topic={a.data.category.id} aria-labelledby={`h-${a.id}`}>
        <div class="story-head">
          <p class="cat">{names.get(a.data.category.id)}</p>
          <h2 id={`h-${a.id}`}><a href={`/news/${a.id}/`}>{a.data.title}</a></h2>
        </div>
        <ul>
          {items.filter((i) => i.article.id === a.id).map((i) => (
            <li data-text={`${i.title} ${i.description} ${i.group} ${a.data.title}`.toLowerCase()}>
              <a class="thumb" href={i.pdf} title={`Download ${i.title} (PDF)`}>
                <Image src={i.preview} alt={i.alt} title={i.title} widths={[240, 360, 480]} sizes="(max-width: 700px) 44vw, 200px" format="webp" quality={62} loading="lazy" decoding="async" />
              </a>
              <h3>{i.title}</h3>
              <p>{i.description}</p>
              <p class="pmeta">{`PDF · ${i.pages} ${i.pages === 1 ? "page" : "pages"} · ${i.paper}`}</p>
              <div class="btns">
                <a class="btn pdf" href={i.pdf} download type="application/pdf">PDF</a>
                <a class="btn png" href={i.png} download type="image/png">PNG</a>
              </div>
            </li>
          ))}
        </ul>
      </section>
      </>
    ))}
    <p class="none" id="pr-none" hidden>No printables match. Clear the search or pick another topic.</p>
    <p class="terms">Free for personal, classroom and office use. See our <a href="/page/terms-of-use/">terms of use</a> for sharing and reuse.</p>
  </div>
  <script is:inline>
    (() => {
      const q = document.getElementById("pr-q"), count = document.getElementById("pr-count"), none = document.getElementById("pr-none");
      const btns = [...document.querySelectorAll(".topics button")];
      let topic = "";
      const run = () => {
        const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        let n = 0;
        for (const s of document.querySelectorAll(".story")) {
          const okTopic = !topic || s.dataset.topic === topic;
          let shown = 0;
          for (const li of s.querySelectorAll("li")) { const ok = okTopic && terms.every((t) => li.dataset.text.includes(t)); li.hidden = !ok; if (ok) shown++; }
          s.hidden = shown === 0; n += shown;
        }
        count.textContent = n === 1 ? "1 printable" : n + " printables";
        none.hidden = n > 0;
      };
      q.addEventListener("input", run);
      for (const b of btns) b.addEventListener("click", () => { topic = b.dataset.topic; btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b))); run(); });
    })();
  </script>
</NewsBase>
<style>
  .hub{width:min(1120px,calc(100% - 2rem));margin:0 auto;padding:clamp(1.5rem,4vw,2.5rem) 0}
  .hub h1{font-family:Sora,"Sora Fallback",ui-sans-serif,system-ui,sans-serif;color:var(--ink-strong);font-size:clamp(1.9rem,5vw,2.6rem);line-height:1.15;margin:0 0 .6rem}
  .hub .news-lede{max-width:46rem}
  .tools{position:sticky;top:66px;z-index:10;background:var(--paper);padding:1rem 0 .6rem;margin:1rem 0 1.25rem;border-bottom:1px solid var(--line-soft);display:grid;gap:.75rem}
  .q span{display:block;font-weight:700;color:var(--ink-strong);margin-bottom:.35rem}
  .q input{width:100%;max-width:28rem;min-height:48px;padding:0 1rem;border:2px solid var(--line);border-radius:6px;font:inherit;font-size:1rem;color:var(--ink-strong);background:#fff}
  .q input:focus{outline:3px solid var(--gold);outline-offset:1px;border-color:var(--focus)}
  .topics{display:flex;flex-wrap:wrap;gap:.4rem}
  .topics button{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;padding:0 .85rem;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink-strong);font:inherit;font-weight:700;font-size:.88rem;cursor:pointer}
  .topics button span{display:inline-grid;place-items:center;min-width:1.4rem;height:1.4rem;padding:0 .3rem;border-radius:999px;background:var(--wash);font-size:.72rem}
  .topics button[aria-pressed="true"]{background:var(--focus);border-color:var(--focus);color:#fff}
  .topics button[aria-pressed="true"] span{background:#fff;color:var(--focus)}
  .count{margin:0;font-size:.85rem;color:var(--ink)}
  .story{margin:0 0 2.25rem}
  .story-head{border-bottom:3px solid var(--ink-strong);margin-bottom:1rem;padding-bottom:.4rem}
  .cat{margin:0 0 .2rem;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--focus)}
  .story h2{font-family:Sora,"Sora Fallback",sans-serif;font-size:1.1rem;line-height:1.3;margin:0}
  .story h2 a{color:var(--ink-strong);text-decoration:none}
  .story h2 a:hover,.story h2 a:focus-visible{text-decoration:underline}
  .story ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem 1rem}
  .story li{display:flex;flex-direction:column}
  .thumb :global(img){display:block;width:100%;height:auto;aspect-ratio:17/22;object-fit:cover;object-position:top;border:1px solid var(--line-soft);border-radius:6px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.06)}
  .story h3{font-family:Sora,"Sora Fallback",sans-serif;font-size:.95rem;line-height:1.3;margin:.6rem 0 .25rem;color:var(--ink-strong)}
  .story li p{margin:0 0 .35rem;font-size:.86rem;line-height:1.4}
  .pmeta{color:var(--ink);font-size:.78rem;padding:0}
  .btns{display:flex;gap:.4rem;margin-top:auto;padding-top:.3rem}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:60px;padding:0 .8rem;border-radius:4px;font-weight:700;font-size:.88rem;text-decoration:none}
  .btn.pdf{background:var(--focus);color:#fff!important}
  .btn.png{border:1px solid var(--focus);background:#fff}
  .btn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
  .none{padding:2rem 0;color:var(--ink)}
  .terms{margin-top:2rem;font-size:.9rem;color:var(--ink)}
  @media (min-width:700px){ .story ul{grid-template-columns:repeat(3,1fr)} }
  @media (min-width:960px){ .story ul{grid-template-columns:repeat(4,1fr)} }
</style>
