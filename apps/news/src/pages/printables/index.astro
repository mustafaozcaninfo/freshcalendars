---
/**
 * Free printables hub: every PDF/PNG template from News stories, filterable by topic and text.
 * The page carries its first screen of cards; the rest come from data.json (same folder), which
 * the script reads once, so search, topics, sort and "show more" cover every printable without a
 * 3.5 MB page. The filter stays in the URL so a filtered view can be shared.
 */
import { Image } from "astro:assets";
import NewsBase from "../../layouts/NewsBase.astro";
import AdSlot from "../../components/AdSlot.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import NewsRail from "../../components/NewsRail.astro";
import { getActiveCategories, getCategoryNames, getPublishedArticles } from "../../lib/articles";
import { allPrintables, PRINTABLES_PATH } from "../../lib/printables";
import { formatDateET, listingGraph } from "../../lib/seo";

const articles = (await getPublishedArticles()).filter((a) => a.data.downloads.length > 0);
const items = allPrintables(articles);
const inkCount = items.filter((i) => i.inkSaver).length;
const names = await getCategoryNames();
const topics = (await getActiveCategories(articles)).map((c) => ({ id: c.id, name: c.data.name, n: items.filter((i) => i.article.category === c.id).length }));
const PAGE = 24;
const AD_AT: Record<number, number> = { 12: 6, 42: 3, 84: 2 };
const first = items.slice(0, PAGE);
/** Words readers search for most; each fills the search box. */
const KINDS = ["calendar", "schedule", "tracker", "checklist", "planner", "bracket", "2027"];
const title = "Free Printable Calendars, Charts and Trackers";
const description = `${items.length} free printable PDF and PNG templates from Fresh Calendars News: holiday calendars, election guides, trackers and more. No sign-up.`;
const jsonLd = listingGraph({
  path: PRINTABLES_PATH,
  name: title,
  description,
  trail: [{ name: "News", path: "/news/" }, { name: "Free printables", path: PRINTABLES_PATH }],
  items: [...new Map(first.map((i) => [i.article.href, i.article.title]))].map(([path, name]) => ({ path, name })),
  kind: "CollectionPage",
});
---
<NewsBase title={`${title} | Fresh Calendars`} description={description} path={PRINTABLES_PATH} jsonLd={jsonLd}>
  <div class="news-workspace"><NewsRail path={PRINTABLES_PATH}/><div class="hub">
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "News", href: "/news/" }, { name: "Free printables" }]} />
    <h1>{title}</h1>
    <p class="news-lede">Every template from our stories in one place: {items.length} free designs as PDF and PNG, most on US Letter paper, made by Fresh Calendars. No account, no email.</p>

    <ol class="steps" aria-label="How to print">
      <li><b>Find it</b><span>Search, or pick a topic below.</span></li>
      <li><b>Open or download</b><span>Tap the picture to open the PDF, or save it with Download.</span></li>
      <li><b>Print at 100%</b><span>Choose "Actual size" in the print dialog.{inkCount > 0 && ` ${inkCount} designs also come in a low-ink version.`}</span></li>
    </ol>

    <div class="tools" id="pr-tools">
      <div class="tools-row">
        <label class="q" for="pr-q"><span class="sr-only">Find a printable</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm5 12 4 4"/></svg>
          <input id="pr-q" type="search" placeholder="Search printables: “thanksgiving”, “tracker”, “2027”" autocomplete="off" />
        </label>
        <label class="sort" for="pr-sort"><span>Sort</span>
          <select id="pr-sort"><option value="new">Newest first</option><option value="az">A to Z</option></select>
        </label>
      </div>
      <div class="kinds" role="group" aria-label="Popular searches"><span>Popular:</span>{KINDS.map((k) => <button type="button" data-kind={k}>{k}</button>)}</div>
      <div class="topics" role="group" aria-label="Filter by topic">
        <button type="button" data-topic="" aria-pressed="true">All<span>{items.length}</span></button>
        {topics.map((t) => <button type="button" data-topic={t.id} aria-pressed="false">{t.name}<span>{t.n}</span></button>)}
      </div>
      <div class="tools-foot">
        <p class="count" id="pr-count" aria-live="polite">{items.length} printables</p>
        <button type="button" class="reset" data-printables-reset hidden>Clear filters</button>
      </div>
    </div>

    <ul class="printables-grid" id="pr-grid">
    {first.map((i, n) => (
      <>
      {AD_AT[n] && <li class="printables-ad" data-at={n}><AdSlot unit={AD_AT[n]!} variant={n === 12 ? "top" : undefined}/></li>}
      <li class="printable-card" data-printable data-n={n} data-title={i.title.toLowerCase()} data-topic={i.article.category} data-text={`${i.title} ${i.description} ${i.group} ${i.article.title}`.toLowerCase()}>
        <a class="thumb" href={i.pdf} target="_blank" rel="noopener" aria-label={`Open ${i.title} (PDF, new tab)`}>
          <Image src={i.preview} alt={i.alt} title={i.title} widths={[240, 360, 480]} sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 300px" format="webp" quality={62} loading="lazy" decoding="async" />
          <span class="open" aria-hidden="true">Open PDF ↗</span>
        </a>
        <div class="body">
          <p class="cat" data-cat={i.article.category}>{names.get(i.article.category)}</p>
          <h2>{i.title}</h2>
          <p class="description">{i.description}</p>
          <ul class="pmeta" aria-label="File details">
            <li>{i.pages} {i.pages === 1 ? "page" : "pages"}</li><li>{i.paper}</li>{i.inkSaver && <li class="ink">Low-ink version</li>}
          </ul>
          <div class="btns">
            <a class="btn pdf" href={i.pdf} download type="application/pdf">Download PDF</a>
            <a class="btn png" href={i.png} download type="image/png" aria-label={`Download ${i.title} as PNG image`}>PNG</a>
          </div>
          {i.inkSaver && <a class="inklink" href={i.inkSaver.pdf} download type="application/pdf">Low-ink PDF (uses less toner)</a>}
          <a class="printable-source" href={i.article.href}><span>From the story · {formatDateET(i.article.publishedAt)}</span>{i.article.title}</a>
        </div>
      </li>
      </>
    ))}
    {Object.entries(AD_AT).filter(([n]) => Number(n) >= PAGE).map(([n, unit]) => <li class="printables-ad" data-at={n} hidden><AdSlot unit={unit}/></li>)}
    </ul>
    <ul class="printables-grid" id="pr-results" hidden></ul>
    <div class="none" id="pr-none" hidden><p><b>No printables match.</b> Try a shorter word, or look in all topics.</p><button type="button" class="btn png" data-printables-reset>Clear filters</button></div>
    <div class="more-wrap"><button type="button" class="more" id="pr-more">Show more printables</button></div>
    <AdSlot unit={5} />
    <p class="terms">Free for personal, classroom and office use. See our <a href="/page/terms-of-use/">terms of use</a> for sharing and reuse.</p>
  </div>
  </div>
  <script is:inline define:vars={{ PAGE, TOTAL: items.length }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      const q = $("pr-q"), sort = $("pr-sort"), grid = $("pr-grid"), results = $("pr-results");
      const count = $("pr-count"), none = $("pr-none"), more = $("pr-more");
      const btns = [...document.querySelectorAll(".topics button")], resets = document.querySelectorAll("[data-printables-reset]");
      const ads = [...grid.querySelectorAll(".printables-ad[data-at]")].filter((a) => Number(a.dataset.at) >= PAGE);
      let topic = "", limit = PAGE, data = null, cats = {}, loading = null;
      const params = new URLSearchParams(location.search);
      if (params.get("q")) q.value = params.get("q");
      if (btns.some((b) => b.dataset.topic === params.get("topic"))) topic = params.get("topic");
      if (params.get("sort") === "az") sort.value = "az";
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      // The same card the page renders for its first screen (keep the two in step).
      const card = (i) => `<li class="printable-card" data-printable data-topic="${esc(i.c)}">
        <a class="thumb" href="${esc(i.p)}" target="_blank" rel="noopener" aria-label="Open ${esc(i.t)} (PDF, new tab)"><img src="${esc(i.i)}" alt="${esc(i.x)}" title="${esc(i.t)}" width="360" height="466" loading="lazy" decoding="async"><span class="open" aria-hidden="true">Open PDF ↗</span></a>
        <div class="body"><p class="cat">${esc(cats[i.c] || i.c)}</p><h2>${esc(i.t)}</h2><p class="description">${esc(i.d)}</p>
        <ul class="pmeta" aria-label="File details"><li>${i.n} ${i.n === 1 ? "page" : "pages"}</li><li>${esc(i.s)}</li>${i.k ? '<li class="ink">Low-ink version</li>' : ""}</ul>
        <div class="btns"><a class="btn pdf" href="${esc(i.p)}" download type="application/pdf">Download PDF</a><a class="btn png" href="${esc(i.g)}" download type="image/png" aria-label="Download ${esc(i.t)} as PNG image">PNG</a></div>
        ${i.k ? `<a class="inklink" href="${esc(i.k)}" download type="application/pdf">Low-ink PDF (uses less toner)</a>` : ""}
        <a class="printable-source" href="${esc(i.h)}"><span>From the story · ${esc(i.e)}</span>${esc(i.a)}</a></div></li>`;
      const load = () => loading ??= fetch("/news/printables/data.json").then((r) => r.json()).then((j) => {
        cats = j.cats;
        data = j.items.map((i, n) => ({ ...i, n0: n, text: `${i.t} ${i.d} ${i.q} ${i.a}`.toLowerCase() }));
      });
      const state = () => {
        const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        return { terms, filtered: !!topic || terms.length > 0 || sort.value === "az" };
      };
      const paint = () => {
        const { terms, filtered } = state();
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.topic === topic)));
        document.querySelectorAll("[data-kind]").forEach((b) => b.setAttribute("aria-pressed", String(terms.length === 1 && terms[0] === b.dataset.kind)));
        resets[0].hidden = !(topic || terms.length);
        const p = new URLSearchParams();
        if (topic) p.set("topic", topic);
        if (terms.length) p.set("q", q.value.trim());
        if (sort.value === "az") p.set("sort", "az");
        history.replaceState(null, "", location.pathname + (p.size ? "?" + p : "") + location.hash);
        let n = TOTAL, shown;
        if (!filtered) {
          // Default view: the page's own cards, then more from the data in the same order.
          results.hidden = true; grid.hidden = false;
          if (data) for (let k = grid.querySelectorAll("[data-printable]").length; k < Math.min(limit, data.length); k++) {
            const ad = ads.find((a) => Number(a.dataset.at) === k);
            if (ad) { ad.hidden = false; grid.append(ad); }
            grid.insertAdjacentHTML("beforeend", card(data[k]));
          }
          shown = grid.querySelectorAll("[data-printable]").length;
        } else {
          if (!data) { count.textContent = "Loading printables…"; return; }
          const list = data.filter((i) => (!topic || i.c === topic) && terms.every((t) => i.text.includes(t)));
          if (sort.value === "az") list.sort((a, b) => a.t.localeCompare(b.t));
          n = list.length; shown = Math.min(n, limit);
          results.innerHTML = list.slice(0, limit).map(card).join("");
          grid.hidden = true; results.hidden = false;
        }
        count.textContent = (n === 1 ? "1 printable" : n.toLocaleString("en-US") + " printables") + (n > shown ? ` · showing ${shown}` : "");
        none.hidden = n > 0;
        more.hidden = n <= shown;
        more.textContent = `Show ${Math.min(PAGE, n - shown)} more (${(n - shown).toLocaleString("en-US")} left)`;
      };
      const run = (keepLimit) => {
        if (!keepLimit) limit = PAGE;
        paint();
        if (!data) load().then(paint, () => { count.textContent = "Could not load the list. Reload the page to try again."; });
      };
      q.addEventListener("input", () => run());
      q.addEventListener("focus", load, { once: true });
      sort.addEventListener("change", () => run());
      more.addEventListener("click", async () => {
        await load();
        const list = state().filtered ? results : grid, before = list.querySelectorAll("[data-printable]").length;
        limit += PAGE; paint();
        list.querySelectorAll("[data-printable] .btn.pdf")[before]?.focus({ preventScroll: true });
      });
      resets.forEach((r) => r.addEventListener("click", () => { q.value = ""; topic = ""; run(); q.focus(); }));
      for (const b of btns) b.addEventListener("click", () => { topic = b.dataset.topic; run(); });
      document.querySelectorAll("[data-kind]").forEach((b) => b.addEventListener("click", () => { q.value = q.value.trim().toLowerCase() === b.dataset.kind ? "" : b.dataset.kind; run(); }));
      // Read the list when the browser is idle, so the first search or "show more" answers at once.
      (window.requestIdleCallback || ((f) => setTimeout(f, 1500)))(load);
      run();
    })();
  </script>
</NewsBase>
<style is:global>
.hub .news-lede{max-width:80ch;margin:12px 0 20px}
.hub .steps{list-style:none;counter-reset:s;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:0 0 20px;padding:0}
.hub .steps li{counter-increment:s;display:grid;grid-template-columns:auto 1fr;gap:2px 12px;align-items:start;padding:16px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:var(--paper)}
.hub .steps li::before{content:counter(s);grid-row:span 2;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--surface-soft);box-shadow:inset 0 0 0 1px var(--line);color:var(--ink-strong);font:600 14px Sora,"Sora Fallback",sans-serif}
.hub .steps b{font:600 15px/1.3 Sora,"Sora Fallback",sans-serif;letter-spacing:-.015em;color:var(--ink-strong)}
.hub .steps span{font-size:15px;line-height:1.5;color:var(--ink)}
.hub .tools{border:1px solid var(--line-soft);border-radius:var(--r-xl);padding:16px;background:var(--surface-soft);display:grid;gap:14px;margin:0 0 24px}
.hub .tools-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.hub .q{flex:1 1 320px;position:relative;display:block}
.hub .q svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);z-index:1;pointer-events:none;color:var(--muted)}
.hub .q input{width:100%;min-height:48px;padding:10px 14px 10px 42px;border:1px solid var(--line);font:inherit;font-size:15px;border-radius:var(--r-md);background:var(--paper);color:var(--ink-strong);box-shadow:var(--shadow-xs)}
.hub .q input:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 16%,transparent)}
.hub .sort{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--ink-strong)}
.hub .sort select{min-height:48px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink-strong);font:inherit;font-size:14px}
.hub .topics{display:flex;flex-wrap:wrap;gap:8px}
.hub .topics button{display:inline-flex;align-items:center;gap:7px;min-height:40px;padding:0 14px;font:600 13px Manrope,"Manrope Fallback",sans-serif;border:1px solid var(--line-soft);border-radius:999px;background:var(--paper);color:var(--ink-strong);cursor:pointer}
.hub .topics button:hover{border-color:var(--line);background:var(--surface-soft)}
.hub .topics button span{display:grid;place-items:center;font-size:12px;min-width:22px;height:20px;padding:0 6px;border-radius:12px;background:var(--surface-soft);color:var(--ink)}
.hub .topics button[aria-pressed=true]{background:var(--ink-strong);border-color:var(--ink-strong);color:var(--paper)}
.hub .topics button[aria-pressed=true] span{background:var(--paper);color:var(--ink-strong)}
.hub .tools-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;min-height:28px}
.hub .count{font-size:14px;font-weight:600;margin:0;color:var(--ink-strong)}
.hub .reset{border:0;background:none;color:var(--focus);font-size:14px;font-weight:600;cursor:pointer;padding:8px 0;text-decoration:underline;text-underline-offset:3px}
.hub .printables-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;list-style:none;padding:0;margin:0}
.hub .printable-card{display:flex;flex-direction:column;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:var(--paper);min-width:0;overflow:hidden;transition:box-shadow .2s ease,border-color .2s ease,transform .2s ease}
.hub .printable-card:hover{border-color:var(--line);box-shadow:var(--n-shadow-h);transform:translateY(-2px)}
.hub .printable-card[hidden],.hub .printables-ad[hidden]{display:none}
.hub .thumb{position:relative;display:block;padding:16px 16px 0;background:var(--surface-soft);border-bottom:1px solid var(--line-soft)}
.hub .thumb img{display:block;width:100%;height:auto;aspect-ratio:17/22;object-fit:cover;object-position:top;background:#fff;border-radius:4px 4px 0 0;box-shadow:0 1px 2px rgba(13,21,18,.08),0 8px 20px -6px rgba(13,21,18,.16)}
.hub .open{position:absolute;right:12px;top:12px;padding:6px 10px;border-radius:999px;background:var(--ink-strong);color:var(--paper);font-size:13px;font-weight:600;opacity:0;transition:opacity .15s ease}
.hub .thumb:hover .open,.hub .thumb:focus-visible .open{opacity:1}
.hub .body{display:flex;flex-direction:column;flex:1;padding:14px 16px 16px}
.hub .cat{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;margin:0 0 6px}
.hub .printable-card h2{font:600 16px/1.35 Sora,"Sora Fallback",sans-serif;letter-spacing:-.02em;color:var(--ink-strong);margin:0 0 8px}
.hub .description{font-size:14px;line-height:1.55;margin:0 0 10px;color:var(--ink);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.hub .pmeta{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px;padding:0}
.hub .pmeta li{font-size:12px;font-weight:600;padding:3px 9px;border-radius:999px;background:var(--surface-soft);color:var(--ink)}
.hub .pmeta .ink{background:var(--surface-tint);color:var(--focus)}
.hub .btns{display:flex;gap:8px;margin-top:auto}
.hub .btn{font-size:14px;font-weight:600;border-radius:var(--r-md);min-height:44px;padding:0 16px;text-decoration:none!important;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.hub .btn.pdf{flex:1;background:var(--brand);color:#fff!important;border:1px solid var(--brand);box-shadow:inset 0 1px 0 rgba(255,255,255,.14)}
.hub .btn.pdf:hover,.hub .btn.pdf:focus-visible{box-shadow:var(--shadow-md)}
.hub .btn.png{border:1px solid var(--line);color:var(--ink-strong)!important;background:var(--paper)}
.hub .btn.png:hover,.hub .btn.png:focus-visible{background:var(--surface-soft)}
.hub .inklink{display:inline-flex;align-items:center;min-height:40px;font-size:14px;font-weight:600;color:var(--focus)}
.hub .printable-source{display:grid;gap:2px;font-size:15px;line-height:1.45;margin-top:12px;padding-top:12px;border-top:1px solid var(--line-soft);text-decoration:none;color:var(--ink-strong)!important;font-weight:600}
.hub .printable-source span{font-size:14px;font-weight:400;color:var(--muted)}
.hub .printable-source:hover{color:var(--accent)!important}
.hub .printables-ad{grid-column:1/-1}.hub .printables-ad .ad-slot{margin:0}
.hub .more-wrap{display:flex;justify-content:center;margin:28px 0}
.hub .more{min-height:48px;padding:0 28px;border-radius:999px;border:1px solid var(--line);background:var(--paper);color:var(--ink-strong);font:600 15px Manrope,"Manrope Fallback",sans-serif;cursor:pointer;box-shadow:var(--shadow-xs)}
.hub .more:hover,.hub .more:focus-visible{background:var(--surface-soft);border-color:color-mix(in srgb,var(--ink-strong) 24%,var(--line))}
.hub .more[hidden]{display:none}
.hub .terms{font-size:15px;color:var(--muted);margin-top:24px}
.hub .none{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;font-size:15px;padding:20px;border:1px dashed var(--line);border-radius:var(--r-lg);color:var(--ink)}
.hub .none p{margin:0}.hub .none b{color:var(--ink-strong)}
.hub .none[hidden]{display:none}
@media(max-width:1000px){.hub .printables-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hub .steps{grid-template-columns:1fr}}
@media(max-width:700px){.hub .printables-grid{grid-template-columns:1fr;gap:14px}.hub .tools{padding:12px}.hub .sort{flex:1 1 100%}.hub .sort select{flex:1}.hub .topics{flex-wrap:nowrap;overflow-x:auto;margin:0 -12px;padding:0 12px 4px;scrollbar-width:thin}.hub .topics button{flex:0 0 auto}.hub .printable-card{display:grid;grid-template-columns:120px minmax(0,1fr)}.hub .thumb{padding:10px;border-bottom:0;border-right:1px solid var(--line-soft)}.hub .open{display:none}.hub .body{padding:12px}.hub .printable-card h2{font-size:15px}.hub .description{-webkit-line-clamp:2;font-size:15px}.hub .btns{flex-wrap:wrap}.hub .btn{padding:0 12px}}
@media print{.hub .tools,.hub .steps,.hub .more-wrap{display:none}}
.hub .kinds{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.hub .kinds button{min-height:36px;padding:0 12px;border:1px solid var(--line-soft);border-radius:999px;background:transparent;color:var(--ink);font:600 13px Manrope,"Manrope Fallback",sans-serif;cursor:pointer}
.hub .kinds button:hover{background:var(--paper);border-color:var(--line)}
.hub .kinds button[aria-pressed=true]{background:var(--paper);border-color:var(--ink-strong);color:var(--ink-strong)}
.hub .printables-grid[hidden]{display:none}
@media(max-width:700px){.hub .kinds{flex-wrap:nowrap;overflow-x:auto;margin:0 -12px;padding:0 12px 2px;scrollbar-width:none}.hub .kinds button{flex:0 0 auto}.hub .steps{display:none}.hub h1{font-size:26px}.hub .news-lede{font-size:16px;line-height:1.5;margin:8px 0 14px}.hub .tools{gap:10px;margin-bottom:16px}}
</style>
