---
import { shopLink, type ShopCampaign } from "../lib/shop";
// The shop earns affiliate commissions, so its links are marked sponsored (audit 06-SPONSORED).
interface Props { campaign: ShopCampaign | null; slug: string }
const { campaign: c, slug } = Astro.props;
---
{c && (
  <aside class="shop-card" aria-labelledby="shop-card-title" data-nosnippet>
    <p class="shop-kicker"><span>From the Fresh Calendars Shop</span> · {c.kicker}</p>
    <h2 id="shop-card-title">{c.title}</h2>
    <p class="shop-text">{c.text}</p>
    <ul class="shop-items">
      {c.items.map((i) => <li><a href={shopLink(i.href, c, slug, "story-card-item")} rel="sponsored nofollow">{i.name}</a></li>)}
    </ul>
    <a class="shop-cta" href={shopLink(c.href, c, slug, "story-card")} rel="sponsored nofollow">{c.cta}</a>
    <p class="shop-note">The shop links to retailers such as Amazon and earns a commission on purchases made through it.</p>
  </aside>
)}
<style>
  .shop-card{background:var(--n-brand-soft);border:1px solid var(--n-border);border-left:4px solid var(--n-brand);border-radius:var(--n-radius);padding:1rem 1.25rem;margin:1.5rem 0}
  .shop-kicker{margin:0 0 .25rem;font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--n-brand)}
  .shop-kicker span{color:var(--muted)}
  .shop-card h2{font-size:1.15rem;margin:0 0 .4rem;color:var(--ink-strong)}
  .shop-text{margin:0 0 .75rem;color:var(--ink);line-height:1.5}
  .shop-items{list-style:none;margin:0 0 .9rem;padding:0;display:flex;flex-wrap:wrap;gap:.4rem}
  .shop-items li{margin:0}
  .shop-items a{display:inline-flex;align-items:center;min-height:36px;padding:.2rem .7rem;border:1px solid var(--n-border);border-radius:999px;background:var(--paper);color:var(--ink-strong);font-weight:600;font-size:.9rem;text-decoration:none}
  .shop-items a:hover{border-color:var(--n-brand);color:var(--n-brand)}
  .shop-cta{display:inline-flex;align-items:center;gap:.45rem;min-height:44px;padding:.55rem 1rem;border-radius:8px;background:var(--n-brand);color:var(--paper);font-weight:700;text-decoration:none}
  .shop-cta::after{content:"\2192";transition:transform .15s ease}
  .shop-cta:hover::after{transform:translateX(3px)}
  .shop-note{margin:.75rem 0 0;font-size:.8rem;color:var(--muted)}
</style>
