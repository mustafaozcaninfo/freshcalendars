---
/**
 * Upcoming key dates with "add to calendar": one Google Calendar link per date and an .ics file
 * with all of them (Apple Calendar, Outlook). On a story the rows are its own dates; on a topic
 * hub each row also links to the story that reports it. Dates come from lib/keydates.ts, which
 * takes them from published stories. The layout script refreshes "In N days" on cached copies.
 */
import { googleCalendarUrl } from "../lib/ics";
import { articlePath } from "../lib/seo";
import { absNewsUrl } from "../lib/site";
import type { KeyDate } from "../lib/keydates";
interface Props {
  dates: (KeyDate & { days: number })[];
  heading: string;
  ics: string;
  /** Link each row to its story (topic hubs); a story's own box does not link to itself. */
  linkStories?: boolean;
}
const { dates, heading, ics, linkStories = false } = Astro.props;
const monthDay = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const weekday = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { weekday: "short", timeZone: "UTC" });
const inDays = (n: number) => (n === 0 ? "Today" : n === 1 ? "Tomorrow" : `In ${n} days`);
---
{dates.length > 0 && (
  <section class="keydates" aria-labelledby="kd-title">
    <h2 id="kd-title">{heading}</h2>
    <ol>
      {dates.map((k) => (
        <li>
          <span class="d"><b>{monthDay(k.date)}</b>{weekday(k.date)}</span>
          <span class="w">
            {linkStories ? <a href={articlePath(k.slug)}>{k.label}</a> : k.label}
            <span class="in" data-days-until={k.date}>{inDays(k.days)}</span>
          </span>
          <a class="add" href={googleCalendarUrl({ date: k.date, title: k.label, url: absNewsUrl(articlePath(k.slug)) })} target="_blank" rel="nofollow noopener" aria-label={`Add ${k.label} to Google Calendar (opens in a new tab)`}>+ Google</a>
        </li>
      ))}
    </ol>
    <p class="all"><a href={ics} download>Add {dates.length === 1 ? "this date" : `all ${dates.length} dates`} to Apple Calendar or Outlook (.ics)</a></p>
  </section>
)}
<style>
  .keydates{margin:1.5rem 0;padding:1rem 1rem .6rem;background:var(--surface-soft);border:1px solid var(--line);border-radius:8px}
  .keydates h2{font-family:Sora,"Sora Fallback",sans-serif;font-size:1.05rem;margin:0 0 .7rem;color:var(--ink-strong)}
  .keydates ol{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
  .keydates li{display:grid;grid-template-columns:3.6rem minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.55rem .65rem;background:#fff;border:1px solid var(--line);border-radius:6px}
  /* Narrow phones: the add-to-calendar button drops under the event, so a long event name keeps its words whole. */
  @media (max-width:380px){ .keydates li{grid-template-columns:3.6rem minmax(0,1fr)} .add{grid-column:2;justify-self:start} }
  .d{display:grid;text-align:center;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--ink)}
  .d b{font-family:Sora,"Sora Fallback",sans-serif;font-size:.95rem;letter-spacing:0;text-transform:none;color:var(--ink-strong)}
  .w{display:grid;gap:.1rem;line-height:1.3;color:var(--ink-strong);font-weight:600}
  .w a{color:var(--ink-strong);text-decoration:none}
  .w a:hover,.w a:focus-visible{text-decoration:underline}
  .in{font-size:.8rem;font-weight:700;color:var(--focus)}
  .add{display:inline-flex;align-items:center;min-height:44px;padding:0 .7rem;border:1px solid var(--line);border-radius:6px;font-size:.82rem;font-weight:700;white-space:nowrap;text-decoration:none;color:var(--ink-strong)}
  .add:hover,.add:focus-visible{border-color:var(--focus);color:var(--focus)}
  .all{margin:.7rem 0 .2rem;font-size:.9rem;font-weight:700}
</style>
