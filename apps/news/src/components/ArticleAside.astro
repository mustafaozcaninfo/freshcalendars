---
/**
 * Wide-screen sidebar: contents list with the current section highlighted, printables and share,
 * then a rail of sticky ad segments. The segments split the rest of the sidebar's height equally;
 * each ad sticks under the header through its share of the story, then slides away as the next
 * one arrives, so a long read sees a fresh unit instead of one ad for the whole page. One rail
 * per page (short stories), two from five sections, three from LONG_STORY_H2 sections.
 */
import type { MarkdownHeading } from "astro";
import ShareBar from "./ShareBar.astro";
import AdSlot from "./AdSlot.astro";
import { PRINTABLES_PATH } from "../lib/printables";
import { LONG_STORY_H2 } from "../lib/ad-units.mjs";
interface Props { headings: MarkdownHeading[]; downloads: number; url: string; title: string; image: string }
const { headings, downloads, url, title, image } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
const rails = items.length >= LONG_STORY_H2 ? 3 : items.length >= 5 ? 2 : 1;
---
<aside class="aside" aria-label="Article tools">
  <div class="stick">
    {items.length >= 3 && (
      <nav class="toc-side" aria-labelledby="toc-side-title">
        <p class="tool-label" id="toc-side-title">On this page</p>
        <ol>{items.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    {downloads > 0 && (
      <a class="dl" href="#downloads"><b>{downloads} free printable{downloads === 1 ? "" : "s"}</b><span>PDF and PNG, no sign-up</span></a>
    )}
    <ShareBar url={url} title={title} image={image} compact />
    <a class="all-pr" href={PRINTABLES_PATH}>Browse all printables →</a>
  </div>
  {Array.from({ length: rails }, () => <div class="rail"><div class="side-ad"><AdSlot unit={3} variant="side" /></div></div>)}
</aside>
<style>
  .aside{display:none}
  @media (min-width:1100px){
    .aside{display:flex;flex-direction:column}
    .stick{padding-bottom:.25rem}
    .rail{flex:1 1 0;min-height:0}
    .rail + .rail{padding-top:2rem}
    .side-ad{width:300px;position:sticky;top:5.25rem}
    .side-ad :global(.ad-slot--side){min-height:296px}
  }
  @media (min-width:1100px) and (min-height:760px){
    .side-ad :global(.ad-slot--side){min-height:646px}
  }
  .tool-label{margin:0 0 .5rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink)}
  .toc-side{margin:0 0 1.25rem}
  .toc-side ol{list-style:none;margin:0;padding:0;border-left:2px solid var(--line-soft)}
  .toc-side a{display:block;padding:.4rem 0 .4rem .85rem;margin-left:-2px;border-left:2px solid transparent;font-size:.9rem;line-height:1.35;color:var(--ink);text-decoration:none}
  .toc-side a:hover,.toc-side a:focus-visible{color:var(--focus)}
  .toc-side a.on{border-left-color:var(--focus);color:var(--focus);font-weight:700}
  .dl{display:grid;gap:.15rem;margin:0 0 1.25rem;padding:.8rem 1rem;border:2px solid var(--gold);border-radius:8px;background:#fffdf3;text-decoration:none;color:var(--ink-strong)}
  .dl b{font-family:Sora,"Sora Fallback",sans-serif;font-size:.95rem}
  .dl span{font-size:.82rem;color:var(--ink)}
  .dl:hover,.dl:focus-visible{border-color:var(--focus)}
  .all-pr{font-weight:700;font-size:.9rem}
</style>
