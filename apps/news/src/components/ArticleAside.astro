---
/**
 * Wide-screen sidebar: contents list with the current section highlighted, Trending now (the
 * related stories are under the story, so the sidebar does not repeat them), printables and share,
 * then a rail of sticky ad segments. The segments split the rest of the sidebar's height equally;
 * each ad sticks under the header through its share of the story, then slides away as the next
 * one arrives, so a long read sees a fresh unit instead of one ad for the whole page. One rail
 * per page (short stories), two from five sections, three from LONG_STORY_H2 sections.
 * Under the contents: the day's other puzzles (puzzle pages), the series' previous and next story,
 * and the story's next dates, so the column answers "what next" before the ads.
 */
import type { MarkdownHeading } from "astro";
import ShareBar from "./ShareBar.astro";
import AdSlot from "./AdSlot.astro";
import Trending from "./Trending.astro";
import { PRINTABLES_PATH } from "../lib/printables";
import { LONG_STORY_H2 } from "../lib/ad-units.mjs";
type Link = { href: string; title: string };
interface Props {
  headings: MarkdownHeading[]; downloads: number; url: string; title: string; image: string; trending: Link[];
  /** The other games published for the same puzzle date. */
  puzzleDay?: { date: string; links: Link[] };
  prev?: Link; next?: Link;
  keyDates?: { date: string; label: string }[];
}
const { headings, downloads, url, title, image, trending, puzzleDay, prev, next, keyDates = [] } = Astro.props;
const dayLabel = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: "UTC" });
const shortDay = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const items = headings.filter((h) => h.depth === 2);
const rails = items.length >= LONG_STORY_H2 ? 3 : items.length >= 5 ? 2 : 1;
---
<aside class="aside" aria-label="Article tools">
  <div class="stick">
    {items.length >= 3 && (
      <nav class="toc-side" aria-labelledby="toc-side-title">
        <p class="tool-label" id="toc-side-title">In This Article</p>
        <ol>{items.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    {puzzleDay && puzzleDay.links.length > 0 && (
      <nav class="side-box" aria-labelledby="pz-day-title">
        <p class="tool-label" id="pz-day-title">More puzzles for {dayLabel(puzzleDay.date)}</p>
        <ul class="pz-day">{puzzleDay.links.map((l) => <li><a href={l.href}>{l.title}</a></li>)}</ul>
      </nav>
    )}
    {(prev || next) && (
      <nav class="side-pn" aria-label="Previous and next in this series">
        {prev && <a href={prev.href} rel="prev"><span>← Previous</span>{prev.title}</a>}
        {next && <a href={next.href} rel="next"><span>Next →</span>{next.title}</a>}
      </nav>
    )}
    {keyDates.length > 0 && (
      <section class="side-box" aria-labelledby="side-kd-title">
        <p class="tool-label" id="side-kd-title">Coming up</p>
        <ul class="side-kd">{keyDates.map((k) => <li><b>{shortDay(k.date)}</b><span>{k.label}</span><em data-days-until={k.date}></em></li>)}</ul>
      </section>
    )}
    <Trending items={trending} place="side" />
    {downloads > 0 && (
      <a class="dl" href="#downloads"><b>{downloads} free printable{downloads === 1 ? "" : "s"}</b><span>PDF and PNG, no sign-up</span></a>
    )}
    <ShareBar url={url} title={title} image={image} compact />
    <a class="all-pr" href={PRINTABLES_PATH}>Browse all printables →</a>
  </div>
  {Array.from({ length: rails }, () => <div class="rail"><div class="side-ad"><AdSlot unit={3} variant="side" /></div></div>)}
</aside>
<style>
  .aside{display:none}
  @media (min-width:1100px){
    .aside{display:flex;flex-direction:column}
    .stick{padding-bottom:.25rem}
    .rail{flex:1 1 0;min-height:0}
    .rail + .rail{padding-top:2rem}
    .side-ad{width:300px;position:sticky;top:5.25rem}
    .side-ad :global(.ad-slot--side){min-height:296px}
  }
  @media (min-width:1100px) and (min-height:760px){
    .side-ad :global(.ad-slot--side){min-height:646px}
  }
  .tool-label{margin:0 0 .5rem;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink)}
  .toc-side{margin:0 0 1.25rem}
  .toc-side ol{list-style:none;margin:0;padding:0;border-left:2px solid var(--line-soft)}
  .toc-side a{display:block;padding:.4rem 0 .4rem .85rem;margin-left:-2px;border-left:2px solid transparent;font-size:.9rem;line-height:1.35;color:var(--ink);text-decoration:none}
  .toc-side a:hover,.toc-side a:focus-visible{color:var(--focus)}
  .toc-side a.on{border-left-color:var(--cat,var(--focus));color:var(--cat,var(--focus));font-weight:700}
  /* The section being read is marked in the story's category color. */
  .toc-side a.on:before{background:var(--cat,var(--focus));color:var(--paper)}
  .dl{display:grid;gap:.15rem;margin:0 0 1.25rem;padding:.8rem 1rem;border:2px solid var(--gold);border-radius:8px;background:var(--surface-warm);text-decoration:none;color:var(--ink-strong)}
  .dl b{font-family:Sora,"Sora Fallback",sans-serif;font-size:.95rem}
  .dl span{font-size:.875rem;color:var(--ink)}
  .dl:hover,.dl:focus-visible{border-color:var(--focus)}
  .all-pr{font-weight:700;font-size:.9rem}
  .side-box{margin:0 0 1.25rem;padding:14px 16px;border:1px solid var(--line-soft);border-radius:9px}
  .side-box .tool-label{font-size:14px;text-transform:none;letter-spacing:0;color:var(--ink-strong)}
  .pz-day{display:grid;grid-template-columns:1fr 1fr;gap:6px;list-style:none;margin:0;padding:0}
  .pz-day a{display:flex;align-items:center;min-height:40px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;font-size:14px;font-weight:700;color:var(--ink-strong);text-decoration:none}
  .pz-day a:hover,.pz-day a:focus-visible{border-color:var(--focus);color:var(--focus)}
  .side-pn{display:grid;gap:8px;margin:0 0 1.25rem}
  .side-pn a{display:grid;gap:2px;padding:10px 12px;border:1px solid var(--line-soft);border-radius:9px;font-size:14px;line-height:1.35;color:var(--ink-strong);text-decoration:none}
  .side-pn a span{font-size:13px;font-weight:700;color:var(--focus)}
  .side-pn a:hover,.side-pn a:focus-visible{border-color:var(--focus)}
  .side-kd{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .side-kd li{display:grid;grid-template-columns:3.6rem 1fr;gap:2px 8px;font-size:14px;line-height:1.35;color:var(--ink-strong)}
  .side-kd b{grid-row:span 2;color:var(--focus)}
  .side-kd em{font-style:normal;font-size:13px;color:var(--muted)}
  .toc-side{padding:16px;background:var(--surface-soft);border-radius:9px;margin-bottom:24px}
  .toc-side .tool-label{font-size:14px;text-transform:none;letter-spacing:0;color:var(--ink-strong)}
  .toc-side ol{counter-reset:section;border:0}
  .toc-side li{counter-increment:section}
  .toc-side a{display:flex;gap:9px;align-items:baseline;border:0;padding:8px 0;font-size:13px;line-height:1.5;margin:0}
  .toc-side a:before{content:counter(section);display:inline-grid;place-items:center;flex-shrink:0;width:21px;height:21px;background:#e7edf3;border-radius:50%;color:#203b50;font-size:13px}
</style>
