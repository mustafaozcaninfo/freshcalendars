---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDateET, isoDateTime } from "../lib/seo";
interface Props { items: { href: string; title: string; image: ImageMetadata; alt: string; publishedAt: Date }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <h2 id="related-title">Related news</h2>
    <ul>
      {items.map((r) => (
        <li>
          <a href={r.href}>
            <Image src={r.image} alt={r.alt} title={r.title} widths={[320, 480, 640]} sizes="(max-width: 600px) 100vw, 230px" format="webp" loading="lazy" decoding="async" />
            <span class="t">{r.title}</span>
          </a>
          <time datetime={isoDateTime(r.publishedAt)}>{formatDateET(r.publishedAt)}</time>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .related ul{list-style:none;margin:0;padding:0;display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
  .related a{display:block;color:var(--ink-strong);text-decoration:none}
  .related a:hover .t,.related a:focus-visible .t{text-decoration:underline}
  .related :global(img){display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:4px;background:var(--wash)}
  .t{display:block;font-weight:700;margin:.5rem 0 .25rem;line-height:1.3}
  .related time{font-size:.85rem;color:var(--ink)}
</style>
