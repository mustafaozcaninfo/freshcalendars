---
/**
 * End-of-story navigation: more stories from the same section (hub → spoke links that keep a
 * category's pages connected) and, for a story in a dated series (daily NBA games, a daily
 * puzzle, NFL weeks), the series' previous and next story. Other stories get no previous/next:
 * the story published just before them is usually about something else.
 */
import { formatDateET, isoDateTime } from "../lib/seo";
type Link = { href: string; title: string; publishedAt: Date };
interface Props { section: { name: string; href: string }; more: Link[]; prev?: Link; next?: Link }
const { section, more, prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="pn" aria-label="Previous and next in this series">
    {prev ? <a class="prev" href={prev.href} rel="prev"><span>← Previous in this series</span><b>{prev.title}</b></a> : <span class="ph"></span>}
    {next ? <a class="next" href={next.href} rel="next"><span>Next in this series →</span><b>{next.title}</b></a> : <span class="ph"></span>}
  </nav>
)}
{more.length > 0 && (
  <section class="more" aria-labelledby="more-title">
    <div class="more-head"><h2 id="more-title">More in {section.name}</h2><a href={section.href}>All {section.name} stories →</a></div>
    <ol>
      {more.map((m) => <li><a href={m.href}>{m.title}</a><time datetime={isoDateTime(m.publishedAt)}>{formatDateET(m.publishedAt)}</time></li>)}
    </ol>
  </section>
)}
<style>
  .more{margin:2.25rem 0 0}
  .more-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:.25rem 1rem;border-bottom:1px solid var(--line);margin-bottom:.4rem}
  .more-head h2{margin:0 0 .6rem;font-size:1.15rem;font-weight:600;letter-spacing:-.02em}
  .more-head a{font-weight:600;font-size:.88rem;text-decoration:none;padding:.4rem 0}
  .more ol{list-style:none;margin:0;padding:0}
  .more li{display:grid;gap:.15rem;padding:.7rem 0;border-bottom:1px solid var(--line-soft)}
  .more li a{font-weight:600;line-height:1.35;color:var(--ink-strong)!important;text-decoration:none}
  .more li a:hover,.more li a:focus-visible{color:var(--accent)!important}
  .more time{font-size:.85rem;color:var(--muted)}
  .pn{display:grid;grid-template-columns:1fr;gap:.75rem;margin:1.75rem 0 0}
  .pn a{display:grid;gap:.25rem;padding:.9rem 1rem;border:1px solid var(--line-soft);border-radius:var(--r-lg);text-decoration:none;color:var(--ink-strong)!important;background:var(--paper);transition:border-color .15s,box-shadow .2s}
  .pn a:hover,.pn a:focus-visible{border-color:var(--line);box-shadow:var(--shadow-md)}
  .pn span{font-size:.72rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
  .pn b{font-family:Sora,"Sora Fallback",sans-serif;font-size:.98rem;font-weight:600;letter-spacing:-.015em;line-height:1.3}
  .ph{display:none}
  @media (min-width:640px){ .pn{grid-template-columns:1fr 1fr} .pn .next{text-align:right} .ph{display:block} }
</style>
