---
/**
 * News home (page 1): lead story with a latest column, "Coming up" dates, the newest free
 * printables, one block per category, then the full story list. Later pages use ListingView.
 * The only scripts are a small client-side search over the stories on this page and the
 * "in N days" refresh for cached copies.
 */
import { Image } from "astro:assets";
import NewsBase from "../layouts/NewsBase.astro";
import ArticleCard from "./ArticleCard.astro";
import AdSlot from "./AdSlot.astro";
import Breadcrumb from "./Breadcrumb.astro";
import Pagination from "./Pagination.astro";
import type { Article, Category } from "../lib/articles";
import { authorHref, categoryHref } from "../lib/articles";
import { pagedTitle, type Page } from "../lib/listing";
import { upcoming } from "../lib/keydates";
import { liveTopics } from "../lib/storygraph";
import { topicPath } from "../lib/topics";
import { allPrintables, PRINTABLES_PATH } from "../lib/printables";
import { articlePath, formatDateET, isoDateTime, listingGraph } from "../lib/seo";

interface Props {
  page: Page<Article>;
  all: Article[];
  heading: string;
  intro: string;
  description: string;
  categories: Category[];
  categoryNames: Map<string, string>;
  authors: { id: string; name: string }[];
}
const { page, all, heading, intro, description, categories, categoryNames, authors } = Astro.props;
const [lead, ...others] = page.items;
const latest = others.slice(0, 4);
const trending = others.slice(4, 9);
const dates = upcoming(new Set(all.map((a) => a.id)), 6);
const topics = liveTopics(all).map(({ topic, items }) => ({ ...topic, count: items.length }));
const printables = allPrintables(all);
const strip = printables.slice(0, 6);
const sections = categories
  .map((c) => ({ c, items: all.filter((a) => a.data.category.id === c.id).slice(0, 3), total: all.filter((a) => a.data.category.id === c.id).length }))
  .filter((s) => s.items.length > 0);
const monthDay = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const weekday = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { weekday: "short", timeZone: "UTC" });
const inDays = (n: number) => (n === 0 ? "Today" : n === 1 ? "Tomorrow" : `In ${n} days`);
const jsonLd = listingGraph({
  path: page.path,
  name: heading,
  description,
  trail: [{ name: "News", path: "/news/" }],
  items: page.items.map((a) => ({ path: articlePath(a.id), name: a.data.title })),
  kind: "CollectionPage",
});
import PreferredSource from "./PreferredSource.astro";
import NewsBar from "./NewsBar.astro";
---
<NewsBase title={pagedTitle(heading, 1)} description={description} path={page.path} jsonLd={jsonLd}>
  <div class="home">
    <header class="concept-news-hero">
      <img src="/news/design/news-desk-v1.webp" width="1600" height="533" alt="Sunlit desk with a coffee cup, a laptop and plants" title="Fresh Calendars News" fetchpriority="high" />
      <div class="news-concept-wrap">
        <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "News", href: "/news/" }]} />
        <h1>News</h1>
        <p>Latest calendar news, holiday dates and practical planning ideas.</p>
      </div>
    </header>
    <NewsBar section="home" />
    <div class="news-concept-wrap">
    {lead && (
      <section class="concept-news-lead" aria-label="Featured and latest stories">
        <article class="concept-feature">
          <a href={articlePath(lead.id)}>
            <Image src={lead.data.hero.src} alt={lead.data.hero.alt} title={lead.data.hero.title ?? lead.data.title} widths={[960,1320,1600]} sizes="1600px" format="webp" loading="eager" />
            <span class="feature-badge">Featured</span>
            <div class="feature-copy"><p>{formatDateET(lead.data.publishedAt)}</p><h2>{lead.data.title}</h2><p class="feature-desc">{lead.data.description}</p><span class="feature-read">Read the story →</span></div>
          </a>
        </article>
        <div class="concept-latest">
          {latest.map(a => <article data-cat={a.data.category.id}>
            <a href={articlePath(a.id)}><Image src={a.data.hero.src} alt={a.data.hero.alt} title={a.data.hero.title ?? a.data.title} widths={[200,320,400]} sizes="(max-width: 700px) 32vw, 220px" format="webp" loading="eager" /><div><span class="story-category">{categoryNames.get(a.data.category.id)}</span><h2>{a.data.title}</h2><time datetime={isoDateTime(a.data.publishedAt)}>◷ {formatDateET(a.data.publishedAt)}</time></div></a>
          </article>)}
        </div>
      </section>
    )}
    <section class="concept-trending" aria-labelledby="trending-heading"><div class="trending-heading"><h2 id="trending-heading">Trending Now</h2><a href="/news/page/2/">View all news →</a></div><ol>{trending.map((a,i) => <li><a href={articlePath(a.id)}><Image src={a.data.hero.src} alt={a.data.hero.alt} title={a.data.hero.title ?? a.data.title} widths={[240,360]} sizes="240px" format="webp" loading="lazy"/><span class="trend-rank">{i+1}</span><h3>{a.data.title}</h3><time datetime={isoDateTime(a.data.publishedAt)}>◷ {formatDateET(a.data.publishedAt)}</time></a></li>)}</ol></section>
    <p class="desk">Reported by {authors.map((a,i)=><>{i>0&&", "}<a href={authorHref(a.id)}>{a.name}</a></>)} · <a href={PRINTABLES_PATH}>{printables.length} free printables</a></p>
    <PreferredSource compact />
    <AdSlot unit={6} variant="top" />

    {dates.length > 0 && (
      <section class="upcoming" aria-labelledby="up-title">
        <h2 class="sec" id="up-title">Coming up</h2>
        <ol>
          {dates.map((k) => (
            <li>
              <a href={articlePath(k.slug)}>
                <span class="date"><b>{monthDay(k.date)}</b>{weekday(k.date)}</span>
                <span class="what">{k.label}</span>
                <span class="in" data-days-until={k.date}>{inDays(k.days)}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {topics.length > 0 && (
      <nav class="topic-nav" aria-labelledby="tp-title">
        <h2 class="sec" id="tp-title">Follow a topic</h2>
        <ul>{topics.map((t) => <li><a href={topicPath(t.slug)}><b>{t.name}</b><span>{t.count} stories</span></a></li>)}</ul>
      </nav>
    )}

    <AdSlot unit={1} />

    {strip.length > 0 && (
      <section class="strip" aria-labelledby="pr-title">
        <div class="sec-head"><h2 class="sec" id="pr-title">Free printables</h2><a href={PRINTABLES_PATH}>All {printables.length} printables →</a></div>
        <ul>
          {strip.map((p) => (
            <li>
              <a href={p.article.href + "#downloads"}>
                <Image src={p.preview} alt={p.alt} title={p.title} widths={[180, 270, 360]} sizes="(max-width: 700px) 42vw, 170px" format="webp" quality={62} loading="lazy" decoding="async" />
                <span>{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="sections">
      {sections.map((s, i) => (
        <>
          <section class="cat-block" data-cat={s.c.id} aria-labelledby={`sec-${s.c.id}`}>
            <div class="sec-head"><h2 class="sec" id={`sec-${s.c.id}`}><a href={categoryHref(s.c.id)}>{s.c.data.name}</a></h2>{s.total > s.items.length && <a href={categoryHref(s.c.id)}>More →</a>}</div>
            <div class="tiles">{s.items.map((a) => <ArticleCard article={a} categoryName={s.c.data.name} headingLevel={3} tile />)}</div>
          </section>
          {i === 1 && <AdSlot unit={3} />}
          {i === 4 && <AdSlot unit={4} />}
        </>
      ))}
    </div>

    <section class="all" aria-labelledby="all-title">
      <h2 class="sec" id="all-title">All stories</h2>
      <ol>
        {page.items.map((a) => (
          <li><a href={articlePath(a.id)}>{a.data.title}</a> <time datetime={isoDateTime(a.data.publishedAt)}>{formatDateET(a.data.publishedAt)}</time></li>
        ))}
      </ol>
      <Pagination page={page} />
    </section>
    <AdSlot unit={5} />
    </div>
  </div>
</NewsBase>
<style>
  .home{width:100%;margin:0;padding:0}
  .top{position:relative;isolation:isolate;overflow:hidden;border-radius:12px;display:grid;gap:1.25rem;margin-bottom:1.5rem;padding:2rem;min-height:230px;align-items:center;background:#153321;color:#fff}
  .news-scenery{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
  .top:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,32,21,.97),rgba(10,32,21,.87) 40%,rgba(10,32,21,.2));z-index:-1}
  .top h1{color:#fff;font-size:2.3rem;letter-spacing:-.04em}
  .top .news-lede{color:#fff;font-size:.9375rem;max-width:52ch}
  .top .desk,.top .desk a{color:#fff;font-size:.8125rem}
  @media(max-width:640px){.top{padding:1.5rem;min-height:240px}.top h1{font-size:1.8rem}.top:after{background:rgba(10,32,21,.9)}}
  .desk{margin:.6rem 0 0;font-size:.95rem;color:var(--ink)}
  .sec{font-family:Sora,"Sora Fallback",sans-serif;font-size:1.15rem;color:var(--ink-strong);margin:0 0 .75rem}
  .sec a{color:var(--ink-strong);text-decoration:none}
  .sec-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;border-bottom:3px solid var(--ink-strong);margin-bottom:1rem}
  .cat-block .sec-head{border-bottom-color:var(--cat)}
  .cat-block .sec a{color:var(--ink-strong)!important}
  .cat-block .sec::before{content:"";display:inline-block;width:.6rem;height:.6rem;border-radius:3px;background:var(--cat);margin-right:.5rem;vertical-align:.12em}
  .sec-head .sec{margin:0 0 .4rem}
  .sec-head > a{font-weight:700;font-size:.92rem;text-decoration:none;padding:.5rem 0}



  .lead-grid{display:grid;gap:1.5rem;margin-bottom:2rem}
  .latest ol{list-style:none;margin:0;padding:0}
  .latest li{padding:.8rem 0;border-top:1px solid var(--n-border)}
  .latest li:first-child{border-top:0;padding-top:0}
  .latest .cat{margin:0 0 .2rem;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
  .latest .cat a{color:var(--cat)!important;text-decoration:none}
  .latest li{border-left:3px solid transparent;transition:border-color .15s ease}
  .latest li:hover{border-left-color:var(--cat);padding-left:.6rem}
  .latest h3{font-family:Sora,"Sora Fallback",sans-serif;font-size:1rem;line-height:1.3;margin:0 0 .3rem}
  .latest h3 a{color:var(--ink-strong);text-decoration:none}
  .latest h3 a:hover,.latest h3 a:focus-visible{text-decoration:underline}
  .latest time,.all time{font-size:.82rem;color:var(--ink)}

  .topic-nav{margin:0 0 2.25rem}
  .topic-nav ul{list-style:none;margin:0;padding:0;display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
  .topic-nav a{display:grid;gap:.1rem;min-height:56px;padding:.65rem .85rem;border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:6px;text-decoration:none;color:var(--ink-strong);background:#fff}
  .topic-nav a:hover,.topic-nav a:focus-visible{border-color:var(--focus)}
  .topic-nav b{font-family:Sora,"Sora Fallback",sans-serif;font-size:.95rem;line-height:1.25}
  .topic-nav span{font-size:.82rem;color:var(--ink)}
  .upcoming{margin:0 0 2.25rem;padding:1.1rem 1.1rem .4rem;background:var(--surface-soft);border:1px solid var(--line);border-radius:8px}
  .upcoming ol{list-style:none;margin:0;padding:0;display:grid;gap:.6rem}
  .upcoming a{display:grid;grid-template-columns:4.2rem 1fr auto;gap:.85rem;align-items:center;padding:.6rem .7rem;background:#fff;border:1px solid var(--line);border-radius:6px;text-decoration:none;color:var(--ink-strong);min-height:56px}
  .upcoming a:hover,.upcoming a:focus-visible{border-color:var(--focus)}
  .upcoming .date{display:grid;text-align:center;font-size:.75rem;color:var(--ink);text-transform:uppercase;letter-spacing:.04em;border-right:1px solid var(--line-soft);padding-right:.6rem}
  .upcoming .date b{font-family:Sora,"Sora Fallback",sans-serif;font-size:1rem;color:var(--focus);text-transform:none;letter-spacing:0}
  .upcoming .what{font-weight:700;line-height:1.3}
  .upcoming .in{font-size:.8rem;font-weight:700;color:var(--warm-ink);background:var(--surface-warm);border-radius:999px;padding:.2rem .6rem;white-space:nowrap}

  .strip{margin:0 0 2.25rem}
  .strip ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
  .strip a{display:grid;gap:.5rem;text-decoration:none;color:var(--ink-strong);font-weight:700;font-size:.9rem;line-height:1.3}
  .strip :global(img){display:block;width:100%;height:auto;aspect-ratio:17/22;object-fit:cover;object-position:top;border:1px solid var(--n-border);border-radius:10px;background:#fff;box-shadow:var(--n-shadow);transition:box-shadow .2s ease,transform .2s ease}
  .strip a:hover :global(img){box-shadow:var(--n-shadow-h);transform:translateY(-3px)}
  .strip a:hover span,.strip a:focus-visible span{text-decoration:underline}

  .sections{display:grid;gap:2.25rem;margin-bottom:2.25rem}
  .tiles{display:grid;gap:1.25rem}

  .all ol{margin:0;padding-left:1.25rem;columns:1}
  .all li{margin:0 0 .55rem;break-inside:avoid}
  .all li a{font-weight:700;color:var(--ink-strong)}

  @media (min-width:700px){
    .strip ul{grid-template-columns:repeat(3,1fr)}
    .tiles{grid-template-columns:repeat(3,1fr)}
    .upcoming ol{grid-template-columns:repeat(2,1fr)}
    .all ol{columns:2;column-gap:2.5rem}
  }
  @media (min-width:960px){
    .lead-grid{grid-template-columns:minmax(0,1fr) 340px;gap:2.5rem}
    .latest{border-left:1px solid var(--line-soft);padding-left:2rem}
    .strip ul{grid-template-columns:repeat(6,1fr)}
    .upcoming ol{grid-template-columns:repeat(3,1fr)}
  }
  @media(max-width:480px){.upcoming a{grid-template-columns:48px minmax(0,1fr);gap:7px 10px}.upcoming .what{min-width:0;overflow-wrap:anywhere}.upcoming .date{grid-row:span 2}.upcoming .in{grid-column:2;justify-self:start;white-space:normal}.upcoming li{min-width:0}}
</style>

<style>
.home{width:100%;padding:0}
.news-concept-wrap{width:min(1320px,calc(100% - 80px));margin:0 auto}
.concept-news-hero{position:relative;isolation:isolate;min-height:180px;display:flex;align-items:center;overflow:hidden;background:#f3f7f8}
.concept-news-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:right center;z-index:-2}
.concept-news-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#f4f8fcee,#f4f8fcfa 42%,#f4f8fc00 80%);z-index:-1}
/* Dark mode: a dark wash over the desk photo, so the page header follows the theme like the rest of the page. */
:global(html[data-theme=dark]) .concept-news-hero{background:#102031}
:global(html[data-theme=dark]) .concept-news-hero:after{background:linear-gradient(90deg,#102031f5,#102031eb 42%,#10203140 80%)}
:global(html[data-theme=dark]) .concept-news-hero :is(h1,p){color:var(--ink-strong)}
.concept-news-hero .news-concept-wrap{padding:23px 0}
.concept-news-hero h1{font:700 44px/1.1 Sora,sans-serif;letter-spacing:-.04em;color:#0e2135;margin:10px 0 10px}
.concept-news-hero p{font-size:13px;color:#0e2135;margin:0;max-width:65ch}
.concept-news-lead{display:grid;grid-template-columns:1.06fr .94fr;gap:24px;margin:20px 0 24px;align-items:stretch}
.concept-feature{position:relative;min-width:0;border-radius:8px;overflow:hidden;min-height:425px;background:#152e3c}
.concept-feature>a{display:block;height:100%;text-decoration:none!important;color:#fff!important}
.concept-feature :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.concept-feature>a:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 25%,#071a25ef 100%)}
/* Top right: story heroes carry their own kicker in the top-left corner. */
.feature-badge{position:absolute;top:15px;right:15px;z-index:1;padding:6px 10px;border-radius:6px;background:#fff;color:#10283b;font-size:11px;font-weight:700;text-transform:uppercase}
.feature-copy{position:absolute;bottom:0;left:0;right:0;z-index:1;padding:22px;background:linear-gradient(180deg,#071a25c4,#071a25f5)}
.feature-copy:before{content:"";position:absolute;bottom:100%;left:0;right:0;height:36px;background:linear-gradient(180deg,transparent,#071a25c4);pointer-events:none}
.feature-copy h2{font:700 25px/1.2 Sora,sans-serif;letter-spacing:-.04em;margin:8px 0;color:#fff}
.feature-copy p{font-size:11px;margin:0;color:#fff}
.feature-copy .feature-desc{font-size:12px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.feature-read{display:block;font-size:11px;margin-top:12px;color:#fff}
.concept-latest{display:grid;grid-template-rows:repeat(4,1fr);gap:10px;min-width:0}
.concept-latest article{border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;min-width:0;background:var(--paper)}
.concept-latest a{height:100%;display:grid;grid-template-columns:40% 1fr;gap:14px;text-decoration:none!important;color:var(--ink-strong)!important}
.concept-latest :global(img){height:100%;min-height:90px;width:100%;object-fit:cover}
.concept-latest a>div{padding:8px 10px 8px 0;align-self:center;min-width:0}
.story-category{font-size:11px;text-transform:uppercase;color:var(--cat);background:color-mix(in srgb,var(--cat) 8%,var(--paper));padding:3px 5px;border-radius:3px}
.concept-latest h2{font-size:13px;line-height:1.35;margin:6px 0;color:var(--ink-strong);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.concept-latest time{font-size:11px;color:var(--muted)}
.trending-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.trending-heading h2{font:700 20px/1.2 Sora,sans-serif;color:var(--ink-strong);letter-spacing:-.03em;margin:0}
.trending-heading>a{font-size:11px;color:var(--focus);text-decoration:none}
.concept-trending ol{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;padding:0;list-style:none;margin:0 0 25px}
.concept-trending li{position:relative;border:1px solid var(--line-soft);border-radius:9px;overflow:hidden;background:var(--paper)}
.concept-trending li>a{position:relative;isolation:isolate;display:flex;flex-direction:column;min-height:139px;padding:12px;text-decoration:none!important;color:var(--ink-strong)!important}
.concept-trending :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.1;z-index:-1}
.trend-rank{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#e8eef4;font-size:11px;color:#0e2135;font-weight:700;margin-bottom:10px}
.concept-trending h3{font-size:11px;line-height:1.4;margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.concept-trending time{font-size:11px;color:var(--muted);margin-top:auto}
@media(max-width:1023px){.news-concept-wrap{width:calc(100% - 40px)}.concept-news-lead{gap:16px}.feature-copy h2{font-size:21px}.concept-feature{min-height:390px}.concept-latest a{gap:10px}.concept-latest h2{font-size:12px}.concept-trending ol{gap:10px}}
@media(max-width:640px){.news-concept-wrap{width:calc(100% - 32px)}.concept-news-hero{min-height:155px}.concept-news-hero h1{font-size:34px}.concept-news-hero p{font-size:11px;max-width:36ch}.concept-news-lead{grid-template-columns:1fr;gap:14px}.concept-feature{min-height:340px}.concept-latest{grid-template-rows:none;grid-template-columns:1fr 1fr;gap:10px}.concept-latest a{display:flex;flex-direction:column;gap:0}.concept-latest :global(img){height:100px;min-height:100px}.concept-latest a>div{padding:10px;width:100%}.concept-latest h2{font-size:11px}.concept-trending ol{display:flex;overflow-x:auto;scrollbar-width:thin}.concept-trending li{flex:0 0 160px}.feature-copy{padding:18px}.feature-copy h2{font-size:22px}}
  @media(max-width:480px){.upcoming a{grid-template-columns:48px minmax(0,1fr);gap:7px 10px}.upcoming .what{min-width:0;overflow-wrap:anywhere}.upcoming .date{grid-row:span 2}.upcoming .in{grid-column:2;justify-self:start;white-space:normal}.upcoming li{min-width:0}}
</style>
