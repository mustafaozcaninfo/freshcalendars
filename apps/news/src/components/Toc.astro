---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[] }
const items = Astro.props.headings.filter((h) => h.depth === 2);
---
{items.length >= 3 && (
  <details class="toc">
    <summary>In this article</summary>
    <ol>{items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </details>
)}
<style>
  .toc{border:1px solid var(--line-soft);border-radius:4px;padding:.75rem 1rem;margin:0 0 1.5rem}
  .toc summary{cursor:pointer;font-weight:700;color:var(--ink-strong);min-height:44px;display:flex;align-items:center}
  .toc ol{margin:.5rem 0 0;padding-left:1.25rem}
  .toc li{margin:.35rem 0}
  .toc a{color:var(--focus)}
</style>
