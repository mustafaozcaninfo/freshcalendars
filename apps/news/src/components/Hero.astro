---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; title: string; caption?: string; credit?: string }
const { src, alt, title, caption, credit = "Illustration: Fresh Calendars" } = Astro.props;
---
<figure class="hero">
  <Picture
    src={src}
    alt={alt}
    title={title}
    formats={["avif", "webp"]}
    quality={62}
    widths={[400, 640, 828, 1080, 1344, 1600]}
    sizes="(max-width: 752px) calc(100vw - 2rem), 720px"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  {(caption || credit) && <figcaption>{caption}{caption && credit && " "}{credit && <span class="credit">{credit}</span>}</figcaption>}
</figure>
<style>
  .hero{margin:0 0 1.5rem}
  .hero :global(img){display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:14px;background:var(--wash);box-shadow:var(--n-shadow)}
  figcaption{font-size:.85rem;color:var(--ink);margin-top:.6rem;line-height:1.45}
  .credit{color:#64748b}
</style>
