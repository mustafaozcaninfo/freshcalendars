---
/**
 * News bar under the site header on every /news/ page: the section list (one crawlable hub link
 * per category, plus Latest and Printables). Search is in the shared site header.
 */
import { categoryHref, getActiveCategories, getPublishedArticles } from "../lib/articles";
import { PRINTABLES_PATH } from "../lib/printables";
interface Props { section?: string }
const { section } = Astro.props;
const cats = await getActiveCategories(await getPublishedArticles());
// The bar holds Latest and the first PRIMARY sections by `order` on one line; the rest (and, on
// phones, every section) live in the More menu, so new categories never wrap or hide the bar.
const PRIMARY = 6;
// Short labels keep the bar on one line; the More menu and category pages use the full names.
const SHORT: Record<string, string> = { "school-calendars": "Schools", "retail-dates": "Retail", "calendar-guides": "Calendars", "money-benefits": "Money", "gaming-tech": "Gaming" };
const all = [
  ...cats.map((c) => ({ id: c.id, name: c.data.name, short: SHORT[c.id] ?? c.data.name, href: categoryHref(c.id) })),
  { id: "printables", name: "Printables", short: "Printables", href: PRINTABLES_PATH },
];
const main = [{ id: "home", name: "All", short: "All", href: "/news/" }, ...all.slice(0, PRIMARY)];
const inMore = all.slice(PRIMARY).some((l) => l.id === section);
---
<div class="newsbar">
  <div class="nb-in">
    <nav class="nb-sections" aria-label="News sections">
      <ul class="nb-main">
        {main.map((l) => <li><a href={l.href} aria-current={l.id === section ? "page" : undefined}>{l.short}</a></li>)}
      </ul>
      <details class="nb-more" data-nb-more>
        <summary class={inMore ? "is-current" : undefined}>More<svg viewBox="0 0 12 12" aria-hidden="true" width="12" height="12"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
        <ul class="nb-panel">
          {all.map((l, i) => <li class={i < PRIMARY ? "nb-dup" : undefined}><a href={l.href} aria-current={l.id === section ? "page" : undefined}>{l.name}</a></li>)}
        </ul>
      </details>
    </nav>
  </div>
</div>
<style>
.newsbar{background:var(--paper);border-bottom:1px solid var(--line-soft)}
.nb-in{width:min(1320px,calc(100% - 80px));margin:0 auto;padding:12px 0}
.nb-sections{display:flex;align-items:center;gap:10px;min-width:0}
.nb-main{display:flex;gap:9px;align-items:center;overflow-x:auto;scrollbar-width:none;list-style:none;padding:0;margin:0;flex:1;min-width:0;white-space:nowrap}
.nb-main a,.nb-more summary{display:inline-flex;align-items:center;gap:5px;min-height:30px;padding:6px 13px;border:1px solid var(--line);border-radius:20px;font-size:11px;line-height:1.2;color:var(--ink-strong)!important;text-decoration:none;font-weight:700}
.newsbar .nb-main a[aria-current=page]{background:var(--accent);color:#fff!important;border-color:var(--accent)}
.nb-more{position:relative;flex-shrink:0}.nb-more summary{cursor:pointer;list-style:none}.nb-more summary::-webkit-details-marker{display:none}.nb-more svg{width:11px;height:11px}
.nb-panel{position:absolute;z-index:65;right:0;top:100%;width:235px;max-height:65vh;overflow:auto;border:1px solid var(--line);border-radius:9px;background:var(--paper);padding:7px;box-shadow:0 8px 25px #10263822;list-style:none;margin:6px 0 0}
.nb-panel a{display:block;font-size:11px;color:var(--ink-strong)!important;text-decoration:none;min-height:36px;padding:9px;border-radius:5px}.nb-panel a:hover{background:var(--surface-tint)}
@media(min-width:900px){.nb-dup{display:none}}
@media(max-width:1023px){.nb-in{width:calc(100% - 40px)}}
@media(max-width:640px){.nb-in{width:calc(100% - 32px);padding:10px 0}.nb-main{gap:6px}.nb-main a,.nb-more summary{font-size:11px;min-height:30px;padding:6px 10px}.nb-panel{width:210px}}
</style>
