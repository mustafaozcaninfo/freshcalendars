---
interface Props { name: string; role: string; bio: string; href: string }
const { name, role, bio, href } = Astro.props;
---
<aside class="author-card" aria-label="About the author">
  <p class="name"><a href={href} rel="author">{name}</a></p>
  <p class="role">{role}</p>
  <p class="bio">{bio}</p>
</aside>
<style>
  .author-card{border:1px solid var(--n-border);border-top:4px solid var(--gold);background:var(--n-soft);border-radius:var(--n-radius);padding:1rem 1.25rem;margin:2rem 0}
  .author-card p{margin:0 0 .35rem}
  .name{font-family:Sora,"Sora Fallback",sans-serif;font-weight:700;font-size:1.05rem}
  .role{font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink)}
  .bio{font-size:.95rem}
</style>
