---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>{c.href && i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  /* One line on every screen: earlier levels stay whole, the current page truncates with an ellipsis. */
  .crumbs ol{list-style:none;margin:0 0 .9rem;padding:0;display:flex;flex-wrap:nowrap;align-items:center;gap:.5rem;font-size:11px;line-height:1.4;color:var(--ink);min-width:0}
  .crumbs li{flex:none;display:flex;align-items:center;gap:.5rem}
  .crumbs li+li::before{content:"";width:.4rem;height:.4rem;border-top:1.6px solid var(--muted);border-right:1.6px solid var(--muted);transform:rotate(45deg);flex:none}
  .crumbs li:last-child{flex:1 1 auto;min-width:0}
  .crumbs li:last-child span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink)}
  .crumbs a{display:inline-flex;align-items:center;min-height:24px;color:var(--focus);font-weight:600;text-decoration:none}
</style>
