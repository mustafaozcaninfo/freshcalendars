---
interface Props { links: { href: string; label: string }[] }
const { links } = Astro.props;
---
<aside class="cal-links" aria-labelledby="cal-links-title">
  <h2 id="cal-links-title">On Fresh Calendars</h2>
  <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
</aside>
<style>
  .cal-links{background:var(--n-brand-soft);border:1px solid #cfe2f6;border-radius:var(--n-radius);padding:1rem 1.25rem;margin:1.5rem 0}
  .cal-links h2{font-size:1rem;margin:0 0 .5rem}
  .cal-links ul{margin:0;padding:0;list-style:none;display:grid;gap:.15rem}
  .cal-links li{margin:0}
  .cal-links a{display:inline-flex;align-items:center;gap:.45rem;min-height:36px;font-weight:700;color:var(--n-brand)}
  .cal-links a::after{content:"\2192";transition:transform .15s ease}
  .cal-links a:hover::after{transform:translateX(3px)}
</style>
