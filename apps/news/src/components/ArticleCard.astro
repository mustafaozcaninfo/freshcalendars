---
import { Image } from "astro:assets";
import type { Article } from "../lib/articles";
import { categoryHref } from "../lib/articles";
import { articlePath, formatDateET, isoDateTime } from "../lib/seo";
interface Props { article: Article; categoryName: string; featured?: boolean; headingLevel?: 2 | 3; /** Image-on-top card for home section grids. */ tile?: boolean }
const { article, categoryName, featured = false, headingLevel = 2, tile = false } = Astro.props;
const d = article.data;
const H = `h${headingLevel}` as "h2" | "h3";
const href = articlePath(article.id);
---
<article class:list={["card", { featured, tile }]} data-cat={d.category.id} data-search-text={`${d.title} ${d.keywords.join(" ")}`.toLowerCase()}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={d.hero.src}
      alt={d.hero.alt}
      title={d.hero.title ?? d.title}
      widths={featured ? [400, 640, 828, 1080, 1344] : tile ? [320, 480, 640] : [160, 240, 320]}
      sizes={featured ? "(max-width: 752px) calc(100vw - 2rem), 720px" : tile ? "(max-width: 700px) calc(100vw - 2rem), 340px" : "120px"}
      format="webp"
      quality={62}
      loading={featured ? "eager" : "lazy"}
      fetchpriority={featured ? "high" : "auto"}
      decoding="async"
    />
  </a>
  <div class="body">
    <p class="cat"><a href={categoryHref(d.category.id)}>{categoryName}</a></p>
    <H class="title"><a href={href}>{d.title}</a></H>
    {featured && <p class="desc">{d.description}</p>}
    <time datetime={isoDateTime(d.publishedAt)}>{formatDateET(d.publishedAt)}</time>
  </div>
</article>
<style>
  .card{display:grid;grid-template-columns:1fr 120px;gap:1rem;align-items:start;padding:1rem 0;border-top:1px solid var(--n-border)}
  .card .thumb{order:2;display:block;border-radius:10px;overflow:hidden;box-shadow:var(--n-shadow);transition:box-shadow .2s ease,transform .2s ease}
  .card:hover .thumb{box-shadow:var(--n-shadow-h);transform:translateY(-2px)}
  .card :global(img){display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;background:var(--wash);transition:transform .35s ease}
  .card:hover :global(img){transform:scale(1.03)}
  .cat{margin:0 0 .4rem}
  .cat a{display:inline-block;padding:.12rem .55rem;border-radius:999px;background:color-mix(in srgb,var(--cat) 10%,var(--paper));color:var(--cat)!important;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;text-decoration:none}
  .title{font-family:Sora,"Sora Fallback",sans-serif;font-size:1.05rem;line-height:1.3;margin:0 0 .35rem}
  .title a{color:var(--ink-strong)!important;text-decoration:none;transition:color .15s ease}
  .title a:hover,.title a:focus-visible{color:var(--cat)!important}
  time{font-size:.85rem;color:var(--ink)}
  .featured{grid-template-columns:1fr;border-top:0;padding-top:0}
  .featured .thumb{order:0;border-radius:14px}
  .featured .title{font-size:clamp(1.3rem,4vw,1.75rem)}
  .desc{margin:0 0 .5rem;color:var(--ink-strong)}
  .tile{grid-template-columns:1fr;gap:.7rem;border-top:0;padding:0}
  .tile .thumb{order:0}
  .tile .title{font-size:1rem}
</style>
