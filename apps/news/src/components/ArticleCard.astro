---
import { Image } from "astro:assets";
import type { Article } from "../lib/articles";
import { categoryHref } from "../lib/articles";
import { articlePath, formatDateET, isoDateTime } from "../lib/seo";
interface Props { article: Article; categoryName: string; featured?: boolean; headingLevel?: 2 | 3 }
const { article, categoryName, featured = false, headingLevel = 2 } = Astro.props;
const d = article.data;
const H = `h${headingLevel}` as "h2" | "h3";
const href = articlePath(article.id);
---
<article class:list={["card", { featured }]}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={d.hero.src}
      alt={d.hero.alt}
      title={d.hero.title ?? d.title}
      widths={featured ? [400, 640, 828, 1080, 1344] : [160, 240, 320]}
      sizes={featured ? "(max-width: 752px) calc(100vw - 2rem), 720px" : "120px"}
      format="webp"
      loading={featured ? "eager" : "lazy"}
      fetchpriority={featured ? "high" : "auto"}
      decoding="async"
    />
  </a>
  <div class="body">
    <p class="cat"><a href={categoryHref(d.category.id)}>{categoryName}</a></p>
    <H class="title"><a href={href}>{d.title}</a></H>
    {featured && <p class="desc">{d.description}</p>}
    <time datetime={isoDateTime(d.publishedAt)}>{formatDateET(d.publishedAt)}</time>
  </div>
</article>
<style>
  .card{display:grid;grid-template-columns:1fr 120px;gap:1rem;align-items:start;padding:1rem 0;border-top:1px solid var(--line-soft)}
  .card .thumb{order:2}
  .card :global(img){display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:4px;background:var(--wash)}
  .cat{margin:0 0 .25rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
  .cat a{color:var(--focus);text-decoration:none}
  .title{font-family:Sora,"Sora Fallback",sans-serif;font-size:1.05rem;line-height:1.3;margin:0 0 .35rem}
  .title a{color:var(--ink-strong);text-decoration:none}
  .title a:hover,.title a:focus-visible{text-decoration:underline}
  time{font-size:.85rem;color:var(--ink)}
  .featured{grid-template-columns:1fr;border-top:0;padding-top:0}
  .featured .thumb{order:0}
  .featured .title{font-size:clamp(1.3rem,4vw,1.75rem)}
  .desc{margin:0 0 .5rem;color:var(--ink-strong)}
</style>
