---
interface Props { points: string[] }
const { points } = Astro.props;
---
<aside class="keypoints" aria-labelledby="kp-title">
  <h2 id="kp-title">Key points</h2>
  <ul>{points.map((p) => <li>{p}</li>)}</ul>
</aside>
<style>
  .keypoints{border:1px solid var(--line-soft);background:var(--surface-soft);padding:1.15rem 1.35rem;margin:0 0 1.5rem;border-radius:var(--n-radius)}
  .keypoints h2{font-family:Sora,"Sora Fallback",sans-serif;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .7rem;color:var(--muted)}
  /* 16 px: the answer summary was 14 px, smaller than the 17 px story text under it. */
  .keypoints ul{margin:0;padding-left:1.15rem;color:var(--ink-strong);font-size:1rem;line-height:1.55}
  .keypoints li::marker{color:var(--accent)}
  .keypoints li+li{margin-top:.45rem}
</style>
