---
interface Props { points: string[] }
const { points } = Astro.props;
---
<aside class="keypoints" aria-labelledby="kp-title">
  <h2 id="kp-title">Key points</h2>
  <ul>{points.map((p) => <li>{p}</li>)}</ul>
</aside>
<style>
  .keypoints{border:1px solid var(--warm-line);border-left:5px solid var(--gold);background:linear-gradient(180deg,var(--surface-warm),#f2ecde);padding:1rem 1.25rem;margin:0 0 1.5rem;border-radius:var(--n-radius);box-shadow:var(--n-shadow)}
  .keypoints h2{font-family:Sora,"Sora Fallback",sans-serif;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;margin:0 0 .6rem;color:var(--warm-ink)}
  .keypoints ul{margin:0;padding-left:1.15rem;color:var(--ink-strong)}
  .keypoints li::marker{color:var(--warm-ink)}
  .keypoints li+li{margin-top:.45rem}
</style>
