---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq-block" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
<style>
  .faq-block details{border-top:1px solid var(--line-soft);padding:.25rem 0}
  .faq-block details:last-child{border-bottom:1px solid var(--line-soft)}
  .faq-block summary{cursor:pointer;font-weight:700;color:var(--ink-strong);min-height:44px;display:flex;align-items:center}
  .faq-block p{margin:.25rem 0 .75rem}
</style>
