---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq-block" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
<style>
  .faq-block details{border:1px solid var(--n-border);border-radius:var(--n-radius);padding:0 1rem;margin:.55rem 0;background:var(--paper);transition:border-color .15s ease,background .2s ease}
  .faq-block details:hover{border-color:var(--line)}
  .faq-block details[open]{background:var(--n-soft)}
  .faq-block summary{cursor:pointer;font-weight:600;color:var(--ink-strong);min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:1rem;list-style:none}
  .faq-block summary::-webkit-details-marker{display:none}
  /* A drawn plus that loses its upright when the answer opens. */
  .faq-block summary::after{content:"";flex:none;width:12px;height:12px;background:linear-gradient(currentColor,currentColor) center/12px 1.5px no-repeat,linear-gradient(currentColor,currentColor) center/1.5px 12px no-repeat;opacity:.6;transition:transform .25s ease}
  .faq-block details[open] summary::after{background:linear-gradient(currentColor,currentColor) center/12px 1.5px no-repeat;transform:rotate(180deg)}
  .faq-block p{margin:0 0 .9rem}
</style>
