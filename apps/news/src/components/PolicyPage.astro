---
import { getEntry, render } from "astro:content";
import NewsBase from "../layouts/NewsBase.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { formatDateET, isoDateTime, policyGraph } from "../lib/seo";
interface Props { id: "about" | "editorial-policy" | "corrections-policy" | "masthead" }
const entry = (await getEntry("policies", Astro.props.id))!;
const { Content } = await render(entry);
const d = entry.data;
const path = `/news/${entry.id}/`;
---
<NewsBase
  title={`${d.title} | Fresh Calendars News`}
  description={d.description}
  path={path}
  jsonLd={policyGraph({ path, name: d.title, description: d.description, schemaType: d.schemaType, modifiedAt: d.updatedAt })}
>
  <article class="news-wrap policy">
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "News", href: "/news/" }, { name: d.title }]} />
    <h1>{d.title}</h1>
    <p class="updated">Last updated <time datetime={isoDateTime(d.updatedAt)}>{formatDateET(d.updatedAt)}</time></p>
    <div class="prose-policy"><Content /></div>
    <nav class="policy-nav" aria-label="News policies">
      <a href="/news/about/">About</a>
      <a href="/news/editorial-policy/">Editorial policy</a>
      <a href="/news/corrections-policy/">Corrections</a>
      <a href="/news/masthead/">Masthead</a>
    </nav>
  </article>
</NewsBase>
<style>
  .updated{font-size:.9rem;margin:0 0 1.5rem}
  .prose-policy{font-size:1.1rem;line-height:1.7;color:var(--ink-strong)}
  .prose-policy :global(h2){font-family:Sora,"Sora Fallback",sans-serif;font-size:1.25rem;margin:2rem 0 .5rem;scroll-margin-top:5rem}
  .prose-policy :global(a){color:var(--focus)}
  .policy-nav{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:2.5rem;padding-top:1rem;border-top:4px solid var(--gold)}
  .policy-nav a{min-height:44px;display:inline-flex;align-items:center;font-weight:700;color:var(--focus)}
</style>
