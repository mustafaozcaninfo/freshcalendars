---
import {
  CSS,
  FONTS_CSS,
  NAV_JS,
  brandHeadLinks,
  siteFooterHtml,
  siteHeaderHtml,
  THEME_BOOT_HTML,
} from "@freshcalendars/site-chrome";
import { NEWS_NAME, absNewsUrl } from "../lib/site";
import { ROBOTS_INDEX, jsonLdString, type HeadTag } from "../lib/seo";
import { ADS_ENABLED, ADS_LOADER_JS, AD_ORIGINS } from "../lib/ads";
import { GA_ENABLED, GA_JS, GA_ORIGINS } from "../lib/analytics";
import { MORE_MENU_JS } from "../lib/search-client";
import { DAYS_JS } from "../lib/keydates";
import { PREF_SRC_JS } from "../lib/preferred-source";

interface Props {
  design?: string;
  title: string;
  description: string;
  /** Site-relative path with trailing slash, e.g. /news/ */
  path: string;
  robots?: string;
  ogType?: "website" | "article";
  /** Page-specific meta/link tags (og:image, article:*, twitter labels…). */
  headTags?: HeadTag[];
  /** One JSON-LD document (usually an @graph). */
  jsonLd?: unknown;
  /** Policy and error pages carry no ads, so they skip the AdSense connection hints and loader. */
  ads?: boolean;
  /** News bar section to mark as current (category id, "home" or "printables"); inferred from path. */
  section?: string;
}

const {
  title,
  description,
  path,
  robots = ROBOTS_INDEX,
  ogType = "website",
  headTags = [],
  jsonLd,
  ads = true,
  section = path === "/news/" ? "home" : path.startsWith("/news/printables/") ? "printables" : /^\/news\/category\/([a-z0-9-]+)\//.exec(path)?.[1],
} = Astro.props;
const withAds = ADS_ENABLED && ads;
// Chrome fetches a story's HTML when the pointer rests on its link (no prerender, so ads and
// analytics never run for pages the reader does not open).
const SPECULATION = JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: "/news/*" }, { not: { href_matches: "/news/downloads/*" } }] }, eagerness: "moderate" }] });
const canonical = absNewsUrl(path);
const designLayout = Astro.props.design ?? (path === "/news/" ? "news-home" : path.startsWith("/news/author/") ? "news-author" : path.startsWith("/news/category/") ? "news-category" : path.startsWith("/news/topic/") ? "news-topic" : path.startsWith("/news/page/") ? "news-pagination" : path.startsWith("/news/printables/") ? "news-printables" : path.startsWith("/news/archive/") ? "news-archive" : ["/news/about/", "/news/editorial-policy/", "/news/corrections-policy/", "/news/masthead/"].includes(path) ? "news-policy" : "news-article");
const today = new Date();
// News pages use two families only: Sora (headings) + Source Sans 3 (everything else,
// DESIGN.md article type). font-display:optional means unpreloaded faces fall back on first view.
const fontPreload = [
  "/fonts/sora-latin-700-normal.woff2",
  "/fonts/source-sans-3-latin-400-normal.woff2",
  "/fonts/source-sans-3-latin-700-normal.woff2",
  "/fonts/manrope-latin-400-normal.woff2",
  "/fonts/manrope-latin-700-normal.woff2",
];
---
<!doctype html>
<html lang="en" class="news" data-design-version="concept-v3" data-design-layout={designLayout}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<Fragment set:html={THEME_BOOT_HTML} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta name="theme-color" content="#007b48" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={NEWS_NAME} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="alternate" type="application/rss+xml" title="Fresh Calendars News" href="/news/feed.xml" />
{headTags.map((t) => (t.tag === "meta" ? <meta {...t.attrs} /> : <link {...t.attrs} />))}
{jsonLd !== undefined && <script type="application/ld+json" is:inline set:html={jsonLdString(jsonLd)} />}
{fontPreload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
<Fragment set:html={brandHeadLinks()} />
{GA_ENABLED && GA_ORIGINS.map((href) => <link rel="dns-prefetch" href={href} />)}
{withAds && AD_ORIGINS.preconnect.map((href) => <link rel="preconnect" href={href} crossorigin />)}
{withAds && AD_ORIGINS.dnsPrefetch.map((href) => <link rel="dns-prefetch" href={href} />)}
<slot name="head" />
<script type="speculationrules" is:inline set:html={SPECULATION} />
<style is:inline set:html={FONTS_CSS + CSS} />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Fragment set:html={siteHeaderHtml(today, { news: true, current: path.startsWith("/news/printables/") ? "printables" : "news" })} />
<main id="main" class="news-main">
<slot />
</main>
<Fragment set:html={siteFooterHtml(today, { news: true })} />
<script is:inline set:html={NAV_JS + (GA_ENABLED ? GA_JS : "") + (withAds ? ADS_LOADER_JS : "") + MORE_MENU_JS + DAYS_JS + PREF_SRC_JS} />
</body>
</html>

<style is:global>
  /* News design tokens: soft borders, rounded cards, one shadow scale, a color per section. */
  html.news{--n-border:var(--line);--n-soft:var(--surface-soft);--n-brand:var(--accent);--n-brand-soft:var(--surface-tint);--n-radius:10px;--n-shadow:0 1px 2px rgba(16,24,40,.03),0 4px 14px rgba(16,24,40,.04);--n-shadow-h:0 2px 4px rgba(16,24,40,.06),0 10px 24px rgba(16,24,40,.09);--cat:var(--accent)}
  html.news [data-cat="holidays"]{--cat:#855449} html.news [data-cat="planning"]{--cat:#34645c} html.news [data-cat="retail-dates"]{--cat:#795f39}
  html.news [data-cat="school-calendars"]{--cat:#416748} html.news [data-cat="sky-events"]{--cat:#625677} html.news [data-cat="time-change"]{--cat:#35696b}
  html.news [data-cat="uk-canada"]{--cat:#755667} html.news [data-cat="puzzles"]{--cat:#665b70}
  html.news [data-cat="elections"]{--cat:#77584b} html.news [data-cat="calendar-guides"]{--cat:#376762} html.news [data-cat="sports"]{--cat:#3d5f80}
  html.news [data-cat="money-benefits"]{--cat:#4b6130} html.news [data-cat="gaming-tech"]{--cat:#55507f}
  html.news ::selection{background:#e8ddc3;color:#111}
  .news-main a{text-underline-offset:.18em;text-decoration-thickness:1px}
  .news-main a:hover{text-decoration-thickness:2px}
  @media (prefers-reduced-motion:reduce){ html.news *{transition:none!important;animation:none!important} }
  .skip-link{position:absolute;left:-999px;top:0;z-index:100;background:#fff;color:var(--focus);padding:.75rem 1rem;font-weight:700}
  .skip-link:focus{left:1rem;top:1rem}
  html.news body{font-family:Manrope,"Manrope Fallback",ui-sans-serif,system-ui,sans-serif}
  .news-main{background:var(--paper);min-height:70vh;color:var(--ink)}
  .news-workspace{display:grid;grid-template-columns:205px minmax(0,1fr);gap:32px;width:min(1320px,calc(100% - 80px));margin:0 auto;align-items:start}
  .news-workspace>.listing,.news-workspace>.policy,.news-workspace>.hub{width:100%;max-width:none;margin:0;padding:25px 0 35px;min-width:0}
  .news-main .news-workspace h1{font-size:28px;line-height:1.24;letter-spacing:-.04em;max-width:33ch}
  .news-workspace .crumbs ol{font-size:11px;margin-bottom:20px}.news-workspace .crumbs a{min-height:24px;text-decoration:none}.news-workspace .crumbs li+li::before{width:3px;height:3px;border-width:1px}
  .news-workspace .news-lede{font-size:12px;line-height:1.7;max-width:80ch;font-family:Manrope,sans-serif}
  @media(max-width:1023px){.news-workspace{grid-template-columns:180px minmax(0,1fr);gap:22px;width:calc(100% - 40px)}}
  @media(max-width:700px){.news-workspace{display:block;width:calc(100% - 32px)}.news-workspace h1{font-size:24px}.news-workspace>.listing,.news-workspace>.policy,.news-workspace>.hub{padding-top:20px}}
  @media print{.news-workspace{display:block}}
  .news-wrap{width:min(720px,calc(100% - 2rem));margin:0 auto;padding:clamp(1.75rem,4vw,2.75rem) 0}
  /* Headings: the calendar site's global h1 caps width at 14-16ch; news headlines use the column. */
  .news-main h1,.news-main h2,.news-main h3{max-width:none;text-wrap:balance}
  .news-main h1{font-family:Sora,"Sora Fallback",ui-sans-serif,system-ui,sans-serif;color:var(--ink-strong);font-size:clamp(1.6rem,1.1rem + 2vw,2.2rem);line-height:1.2;letter-spacing:-.035em;margin:0 0 .75rem}
  .news-main h1.long{font-size:clamp(1.55rem,1.05rem + 2.1vw,2.3rem);line-height:1.15}
  .news-main p,.news-main li{text-wrap:pretty}
  .news-lede{font-family:"Source Sans 3","Source Sans 3 Fallback",ui-sans-serif,system-ui,sans-serif;font-size:clamp(1.06rem,1rem + .35vw,1.22rem);line-height:1.5;color:var(--ink);margin:0;max-width:68ch}
  .news-main :focus-visible{outline:3px solid var(--focus);outline-offset:2px}
  /* Below-the-fold chrome renders only when scrolled near (faster first paint on long stories). */
  html.news .site-footer{content-visibility:auto;contain-intrinsic-size:auto 640px}
  /* :where keeps this default at class weight, so a component that colors its own links or buttons wins. */
  .news-main :where(a:not(.btn)){color:var(--focus)}
  /* Ad units: labeled, height reserved before fill (no CLS), collapsed (by the loader, off screen only) if AdSense returns nothing.
     The top unit never collapses: it sits right under the headline, so collapsing it would shift the story. */
  .ad-slot{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;width:100%;min-height:300px;margin:2rem auto;padding:.4rem 0 .6rem;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);contain:layout;clear:both}
  .ad-slot::before{content:"Advertisement";display:block;margin:0 0 .4rem;font:700 .68rem/1 "Source Sans 3","Source Sans 3 Fallback",sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
  .ad-slot ins.adsbygoogle{width:100%}
  .ad-slot.ad-off{display:none}
  /* Top unit: label + padding + a 280px desktop ad, so the fill does not grow the box. */
  .ad-slot--top{margin:1.25rem auto 1.5rem}
  /* Phones: AdSense opens a full-width responsive unit as a square (viewport width) plus the label. */
  @media (max-width:767px){ .ad-slot--top{min-height:calc(100vw + 36px)} }
  .ad-slot--side{min-height:280px;margin:1.25rem 0 0;border-bottom:0}
  @media (min-width:768px){ .ad-slot--wide{min-height:280px} .ad-slot--top{min-height:316px} }
  /* Banner above the story headline: a fixed-size unit in a box of fixed height (label + ad), so it
     cannot shift the headline whether it fills or not. */
  .ad-slot--banner{height:136px;min-height:136px;margin:0 auto;padding:.5rem 0;border-top:0;overflow:hidden}
  .ad-slot--banner ins.ad-banner{width:320px;height:100px}
  @media (min-width:768px){ .ad-slot--banner{height:126px;min-height:126px} .ad-slot--banner ins.ad-banner{width:728px;height:90px} }
  @media print{ .ad-slot{display:none!important} }
</style>
