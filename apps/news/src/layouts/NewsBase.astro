---
import {
  CSS,
  FONTS_CSS,
  NAV_JS,
  brandHeadLinks,
  siteFooterHtml,
  siteHeaderHtml,
} from "@freshcalendars/site-chrome";
import { NEWS_NAME, absNewsUrl } from "../lib/site";
import { ROBOTS_INDEX, jsonLdString, type HeadTag } from "../lib/seo";
import { ADS_ENABLED, ADS_LOADER_JS, AD_ORIGINS } from "../lib/ads";
import { GA_ENABLED, GA_JS, GA_ORIGINS } from "../lib/analytics";
import { SEARCH_JS } from "../lib/search-client";
import NewsBar from "../components/NewsBar.astro";

interface Props {
  title: string;
  description: string;
  /** Site-relative path with trailing slash, e.g. /news/ */
  path: string;
  robots?: string;
  ogType?: "website" | "article";
  /** Page-specific meta/link tags (og:image, article:*, twitter labels…). */
  headTags?: HeadTag[];
  /** One JSON-LD document (usually an @graph). */
  jsonLd?: unknown;
  /** Policy and error pages carry no ads, so they skip the AdSense connection hints and loader. */
  ads?: boolean;
  /** News bar section to mark as current (category id, "home" or "printables"); inferred from path. */
  section?: string;
}

const {
  title,
  description,
  path,
  robots = ROBOTS_INDEX,
  ogType = "website",
  headTags = [],
  jsonLd,
  ads = true,
  section = path === "/news/" ? "home" : path.startsWith("/news/printables/") ? "printables" : /^\/news\/category\/([a-z0-9-]+)\//.exec(path)?.[1],
} = Astro.props;
const withAds = ADS_ENABLED && ads;
// Chrome fetches a story's HTML when the pointer rests on its link (no prerender, so ads and
// analytics never run for pages the reader does not open).
const SPECULATION = JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: "/news/*" }, { not: { href_matches: "/news/downloads/*" } }] }, eagerness: "moderate" }] });
const canonical = absNewsUrl(path);
const today = new Date();
// News pages use two families only: Sora (headings) + Source Sans 3 (everything else,
// DESIGN.md article type). font-display:optional means unpreloaded faces fall back on first view.
const fontPreload = [
  "/fonts/sora-latin-700-normal.woff2",
  "/fonts/source-sans-3-latin-400-normal.woff2",
  "/fonts/source-sans-3-latin-700-normal.woff2",
];
---
<!doctype html>
<html lang="en" class="news">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta name="theme-color" content="#007bff" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={NEWS_NAME} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="alternate" type="application/rss+xml" title="Fresh Calendars News" href="/news/feed.xml" />
{headTags.map((t) => (t.tag === "meta" ? <meta {...t.attrs} /> : <link {...t.attrs} />))}
{jsonLd !== undefined && <script type="application/ld+json" is:inline set:html={jsonLdString(jsonLd)} />}
{fontPreload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
<Fragment set:html={brandHeadLinks()} />
{GA_ENABLED && GA_ORIGINS.map((href) => <link rel="dns-prefetch" href={href} />)}
{withAds && AD_ORIGINS.preconnect.map((href) => <link rel="preconnect" href={href} crossorigin />)}
{withAds && AD_ORIGINS.dnsPrefetch.map((href) => <link rel="dns-prefetch" href={href} />)}
<slot name="head" />
<script type="speculationrules" is:inline set:html={SPECULATION} />
<style is:inline set:html={FONTS_CSS + CSS} />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Fragment set:html={siteHeaderHtml(today, { news: true, current: "news" })} />
<NewsBar section={section} />
<main id="main" class="news-main">
<slot />
</main>
<Fragment set:html={siteFooterHtml(today, { news: true })} />
<script is:inline set:html={NAV_JS + (GA_ENABLED ? GA_JS : "") + (withAds ? ADS_LOADER_JS : "") + SEARCH_JS} />
</body>
</html>

<style is:global>
  .skip-link{position:absolute;left:-999px;top:0;z-index:100;background:#fff;color:var(--focus);padding:.75rem 1rem;font-weight:700}
  .skip-link:focus{left:1rem;top:1rem}
  html.news body{font-family:"Source Sans 3","Source Sans 3 Fallback",ui-sans-serif,system-ui,sans-serif}
  .news-main{background:var(--paper);min-height:70vh;color:var(--ink)}
  /* White on brand blue is 3.97:1 — passes WCAG AA only as large text (≥18.67px bold). */
  html.news .nav-toggle-label{font-size:1.1875rem}
  .news-wrap{width:min(720px,calc(100% - 2rem));margin:0 auto;padding:clamp(1.75rem,4vw,2.75rem) 0}
  /* Headings: the calendar site's global h1 caps width at 14-16ch; news headlines use the column. */
  .news-main h1,.news-main h2,.news-main h3{max-width:none;text-wrap:balance}
  .news-main h1{font-family:Sora,"Sora Fallback",ui-sans-serif,system-ui,sans-serif;color:var(--ink-strong);font-size:clamp(1.75rem,1.15rem + 2.4vw,2.6rem);line-height:1.12;letter-spacing:-.015em;margin:0 0 .75rem}
  .news-main h1.long{font-size:clamp(1.55rem,1.05rem + 2.1vw,2.3rem);line-height:1.15}
  .news-main p,.news-main li{text-wrap:pretty}
  .news-lede{font-family:"Source Sans 3","Source Sans 3 Fallback",ui-sans-serif,system-ui,sans-serif;font-size:clamp(1.06rem,1rem + .35vw,1.22rem);line-height:1.5;color:var(--ink);margin:0;max-width:68ch}
  .news-main :focus-visible{outline:3px solid var(--gold);outline-offset:2px}
  /* Below-the-fold chrome renders only when scrolled near (faster first paint on long stories). */
  html.news .site-footer{content-visibility:auto;contain-intrinsic-size:auto 640px}
  .news-main a:not(.btn){color:var(--focus)}
  /* Ad units: labeled, height reserved before fill (no CLS), collapsed (by the loader, off screen only) if AdSense returns nothing.
     The top unit never collapses: it sits right under the headline, so collapsing it would shift the story. */
  .ad-slot{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;width:100%;min-height:300px;margin:2rem auto;padding:.4rem 0 .6rem;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);contain:layout;clear:both}
  .ad-slot::before{content:"Advertisement";display:block;margin:0 0 .4rem;font:700 .68rem/1 "Source Sans 3","Source Sans 3 Fallback",sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
  .ad-slot ins.adsbygoogle{width:100%}
  .ad-slot.ad-off{display:none}
  /* Top unit: label + padding + a 280px desktop ad, so the fill does not grow the box. */
  .ad-slot--top{margin:1.25rem auto 1.5rem}
  .ad-slot--side{min-height:280px;margin:1.25rem 0 0;border-bottom:0}
  @media (min-width:768px){ .ad-slot--wide{min-height:280px} .ad-slot--top{min-height:316px} }
  @media print{ .ad-slot{display:none!important} }
</style>
